#include "acl/acl.h"
#include <cstdint>

__global__ __aicore__ void MiniAddKernel(__gm__ const uint8_t* src, __gm__ uint8_t* dst, int32_t n) {
    if (get_block_idx() == 0) {
        for (int32_t i = 0; i < n; i++) { dst[i] = src[i] + 1; }
    }
}

extern "C" int mini_add_launch(const void* src, void* dst, int32_t n, aclrtStream stream) {
    MiniAddKernel<<<8, 0, stream>>>(reinterpret_cast<const uint8_t*>(src), reinterpret_cast<uint8_t*>(dst), n);
    return 0;
}
