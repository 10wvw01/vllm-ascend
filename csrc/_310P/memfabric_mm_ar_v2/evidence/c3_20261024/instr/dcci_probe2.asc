// C3-1c DCCI 编码探针 v2：运行时偏移（模拟生产核 CleanLines 循环变量寻址）。
// 0 次 vs 4 次 vs 8 次 SINGLE_CACHE_LINE DCCI，地址 = p + base + k*64（base 为核参数）。
#include "kernel_operator.h"
using namespace AscendC;

#define DCCI_VAR(p, off) \
    do { \
        g.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p + off), 16); \
        DataCacheCleanAndInvalid<int32_t, CacheLine::SINGLE_CACHE_LINE>(g); \
    } while (0)

__global__ __aicore__ void DcciVar0(__gm__ uint8_t* p, __gm__ uint32_t* sink, uint32_t base)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    GlobalTensor<int32_t> g;
    (void)p; (void)base;
    *sink = 0;
}

__global__ __aicore__ void DcciVar4(__gm__ uint8_t* p, __gm__ uint32_t* sink, uint32_t base)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    GlobalTensor<int32_t> g;
    uint32_t o = base;
    DCCI_VAR(p, o);
    o += 64; DCCI_VAR(p, o);
    o += 64; DCCI_VAR(p, o);
    o += 64; DCCI_VAR(p, o);
    *sink = 4;
}

__global__ __aicore__ void DcciVar8(__gm__ uint8_t* p, __gm__ uint32_t* sink, uint32_t base)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    GlobalTensor<int32_t> g;
    uint32_t o = base;
    DCCI_VAR(p, o);
    o += 64; DCCI_VAR(p, o);
    o += 64; DCCI_VAR(p, o);
    o += 64; DCCI_VAR(p, o);
    o += 64; DCCI_VAR(p, o);
    o += 64; DCCI_VAR(p, o);
    o += 64; DCCI_VAR(p, o);
    o += 64; DCCI_VAR(p, o);
    *sink = 8;
}
