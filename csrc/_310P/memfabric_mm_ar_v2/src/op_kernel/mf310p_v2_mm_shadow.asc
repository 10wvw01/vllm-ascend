// 仅限A1-MM-01/02影子MM诊断；正式D4内核及Host ABI完全不修改。
// 同构要点：M2048/4096, Chunk1024, 8核M切, NZ B, CONFIG_NORM,
// 与正式D4相同的UB/IB/Vector 预留；仅剔除 IB/SDMA/Add/DONE。
// 本核不是正式融合MM阶段时间戳；单独测得的是无通信条件下的计算实现耗时。
#include "mf310p_v2_kernel_common.h"

namespace {
constexpr uint32_t kShadowAddTile = 2048;
constexpr uint32_t kShadowAddBytes = kShadowAddTile * sizeof(float16_t);
constexpr uint32_t kShadowVectorReserve = 3 * kShadowAddBytes;
static_assert(kShadowAddBytes % 32 == 0, "D4 Add tile alignment");

template<const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2MmShadowKernel(
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* c,
    uint32_t chunks, uint32_t cleanOutput, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable || !chunks) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;

    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    static_assert(TOTAL_UB_SIZE > kUBForIB + kShadowVectorReserve,
                  "D4 shadow UB budget insufficient");
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kShadowVectorReserve - kUBForIB);
    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kShadowAddBytes);
    pipe.InitBuffer(in1, 1, kShadowAddBytes);
    pipe.InitBuffer(outQ, 1, kShadowAddBytes);

    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t perCoreBytes = CHUNK * kRowBytes / kCores;
    const uint64_t chunkBytes = CHUNK * kRowBytes;
    const uint64_t coreOff = static_cast<uint64_t>(core) * perCoreBytes;

    for (uint32_t k = 0; k < chunks; ++k) {
        const uint64_t start = static_cast<uint64_t>(k) * chunkBytes;
        GlobalTensor<float16_t> ag, cg;
        ag.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(x + start + coreOff),
            rowsPerCore * kK);
        cg.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(c + start + coreOff),
            rowsPerCore * kN);
        mm.SetTensorA(ag, false);
        mm.SetTensorB(wg, true);
        mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
        mm.IterateAll(cg);
        // 只在C1模式清理缓存行，与正式D4的MM后CleanLines语义一致；
        // CleanLines耗时是单变量开销，不是正式流水中的可加分段时长。
        if (cleanOutput != 0) {
            CleanLines(c + start + coreOff, perCoreBytes);
        }
    }
}
} // shadow only

// 独立影子设备SO内唯一导出入口；不向Serving暴露。
extern "C" int mf310p_v2_mm_shadow_launch_async(
    uint64_t x, uint64_t w, uint64_t out, uint32_t m,
    uint32_t cleanOutput, uint32_t enable, aclrtStream stream)
{
    if (!stream || (m != 2048 && m != 4096) || cleanOutput > 1 ||
        enable > 1 || (enable && (!x || !w || !out)))
        return -1;
    V2MmShadowKernel<tiling1024, 1024><<<kCores, 0, stream>>>(
        reinterpret_cast<uint8_t*>(x),
        reinterpret_cast<uint8_t*>(w),
        reinterpret_cast<uint8_t*>(out),
        m / 1024, cleanOutput, enable);
    return 0;
}
