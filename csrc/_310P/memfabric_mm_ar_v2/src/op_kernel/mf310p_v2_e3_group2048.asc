// E3-G/T：真实Chunk2048（8MiB）MM/通信组，MemFabric拆2×4MiB有界分包。
// G模式：每核2×1024行组MM子调用；T模式：1×2048行组MM调用。
// 继承E1整核DCCI、ReadyTree、Add2048及QUIET/DONE，正式D4/E1文件不动。
#include "mf310p_v2_kernel_common.h"

namespace {
// CANN9.1 ENTIRE_DATA_CACHE为每核整缓存Clean+Invalid，并非跳过缓存一致性。
// 测试性替代原始每64B遍历：其性能和跨AICore/SDMA一致性尚须310P3实机验证。
 // 注意整核刷新可能比定址DCCI更慢；任何bit-exact/首写/尾延迟异常直接STOP。
// E1 8核Ready树：将Core0的7次串行IBWait改为4次；其余3次
// 等待分配给Core2/4/6，在MM+Flush完成后独立完成局部汇聚。
// 每个IBReady事件恰有一个消费者，不删除任何跨核完成依赖。
__aicore__ inline void ReadyTree(
    const GlobalTensor<int32_t>& ibGm,
    const LocalTensor<int32_t>& ibUb, uint32_t core)
{
    if (core == 0) {
        IBWait<true>(ibGm, ibUb, 1, kIBReady);
        IBWait<true>(ibGm, ibUb, 2, kIBReady);
        IBWait<true>(ibGm, ibUb, 4, kIBReady);
        IBWait<true>(ibGm, ibUb, 6, kIBReady);
        return;
    }
    if (core == 2 || core == 4 || core == 6) {
        IBWait<true>(ibGm, ibUb, core + 1, kIBReady);
    }
    IBSet<true>(ibGm, ibUb, core, kIBReady);
}

__aicore__ inline void FlushCoreDCache(__gm__ uint8_t* validGm)
{
    GlobalTensor<int32_t> fence;
    fence.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(validGm), 16);
    DataCacheCleanAndInvalid<int32_t, CacheLine::ENTIRE_DATA_CACHE>(fence);
}

// D3/C2 单变量实验：仅正式 V2 的 Vector Add 批量从 1024→2048 个 FP16。
// 诊断 Kernel 仍使用 kernel_common.h 中的 kAddTile=1024，避免污染对照组。
// 不变更 MM tiling、通信顺序、IB、DCCI、DONE 或 Torch ABI。
// MemFabric单条SDMA在310P3上只验证到4MiB。2048行=8MiB，必须拆2包。
constexpr uint32_t kE3GroupRows = 2048;
constexpr uint32_t kE3PacketRows = 1024;
constexpr uint32_t kE3PacketsPerGroup = kE3GroupRows / kE3PacketRows;
constexpr uint64_t kE3PacketBytes = static_cast<uint64_t>(kE3PacketRows) * kRowBytes;
static_assert(kE3GroupRows * kRowBytes == 8ULL * 1024 * 1024,
    "E3 2048-row logical group must be 8MiB");
static_assert(kE3PacketBytes == 4ULL * 1024 * 1024 && kE3PacketsPerGroup == 2,
    "Every E3 transport packet must stay at verified 4MiB maximum");

// 独立新增tiling，不修改共用kernel_common.h或已有设备入口。
// CHUNK2048 = 每核256行，BASIC_M=256，仅用于T模式。
constexpr MatmulShapeParams e3Shape2048 = {256, kN, kK, 256, 256, 64};
constexpr MatmulConfig e3Cfg2048 =
    GetMMConfig<MatmulConfigMode::CONFIG_NORM>(
        e3Shape2048, kQuant, kBatch, kFunc);
constexpr static MatmulApiStaticTiling e3Tiling2048 =
    GetMatmulApiTiling<AT, BT, CT, BiasT>(e3Cfg2048, Impl::L1_SIZE);

__aicore__ inline void E3WaitGroup(
    __gm__ uint8_t* reserved, uint64_t expectedRecvDst,
    uint32_t group, __gm__ uint8_t* status, uint64_t code)
{
    // 发送包各有独立tag，接收顺序可能不同；不依赖两个packet先后。
    // 但必须完整收到“当前待Add组”的两封唯一信件，才向核1~7发布Add。
    uint32_t received = 0;
    for (uint32_t i = 0; i < kE3PacketsPerGroup; ++i) {
        const auto mail = smem_shm_sdma_wait_at(reserved);
        bool match = false;
        for (uint32_t part = 0; part < kE3PacketsPerGroup; ++part) {
            const uint32_t bit = 1U << part;
            const uint32_t tag = group * kE3PacketsPerGroup + part;
            if ((received & bit) == 0 &&
                mail.status == SMEM_SHM_SDMA_MAIL_OK &&
                mail.dst == expectedRecvDst +
                    static_cast<uint64_t>(tag) * kE3PacketBytes &&
                mail.len == kE3PacketBytes &&
                mail.imm == (kTagBase | tag)) {
                received |= bit;
                match = true;
                break;
            }
        }
        CheckOrTrap(match, status, code);
    }
    CheckOrTrap(received == 3, status, code);
}

constexpr uint32_t kProductionAddTile = 2048;
constexpr uint32_t kProductionAddBytes = kProductionAddTile * sizeof(float16_t);
constexpr uint32_t kProductionUBForVector = 3 * kProductionAddBytes;
static_assert(kProductionAddBytes % 32 == 0, "Vector buffer must be 32B aligned");
static_assert((256 / kCores) * kN % kProductionAddTile == 0,
              "The smallest supported Chunk must be divisible by the Add tile");

template <const MatmulApiStaticTiling& TILING, uint32_t MM_ROWS>
__global__ __aicore__ void E3Group2048Kernel(
    __gm__ uint8_t* gva,
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    __gm__ uint8_t* ownC, __gm__ uint8_t* ownPeerC,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* status,
    __gm__ uint8_t* ctrlSrc, __gm__ uint8_t* peerCtrlDst,
    uint64_t expectedCtrlDst,
    uint32_t chunks, uint32_t overlap, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (enable == 0 || chunks == 0) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;

    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    // CANN 9.1 头文件中 TOTAL_UB_SIZE 仅在核函数(device)上下文可见，
    // 因此 UB 预算断言必须与被守护的 InitBuffer 同处设备侧。
    static_assert(TOTAL_UB_SIZE > kUBForIB + kProductionUBForVector,
                  "Not enough UB for IB, Vector queues and Matmul local workspace");
    // Matmul SetLocalWorkspace 的最小临时空间仍需 310P3 BiSheng 实机编译/资源核验。
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kProductionUBForVector - kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
                         kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = syncBuf.Get<int32_t>();

    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kProductionAddBytes);
    pipe.InitBuffer(in1, 1, kProductionAddBytes);
    pipe.InitBuffer(outQ, 1, kProductionAddBytes);

    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    constexpr uint32_t kComputeCalls = kE3GroupRows / MM_ROWS;
    constexpr uint32_t kComputeRowsPerCore = MM_ROWS / kCores;
    constexpr uint64_t kComputeBytesPerCore =
        static_cast<uint64_t>(kComputeRowsPerCore) * kRowBytes;
    constexpr uint64_t perCoreBytes =
        static_cast<uint64_t>(kE3GroupRows) * kRowBytes / kCores;
    constexpr uint64_t chunkBytes = static_cast<uint64_t>(kE3GroupRows) * kRowBytes;
    static_assert(MM_ROWS == 1024 || MM_ROWS == 2048, "E3 MM tile must be 1024/2048");
    static_assert(kE3GroupRows % MM_ROWS == 0, "whole MM subtiles only");
    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);

    for (uint32_t k = 0; k < chunks; ++k) {
        const uint64_t start = static_cast<uint64_t>(k) * chunkBytes;
        const uint64_t coreOff = static_cast<uint64_t>(core) * perCoreBytes;
        // E3-G: 两次1024子MM完整写入这一核的256行；
        // E3-T: 一次2048 MM完成同样256行。Ready/SDMA在整个2048组后。
        for (uint32_t t = 0; t < kComputeCalls; ++t) {
            const uint64_t off = start + coreOff +
                static_cast<uint64_t>(t) * kComputeBytesPerCore;
            GlobalTensor<float16_t> ag, cg;
            ag.SetGlobalBuffer(
                reinterpret_cast<__gm__ float16_t*>(x + off),
                kComputeRowsPerCore * kK);
            cg.SetGlobalBuffer(
                reinterpret_cast<__gm__ float16_t*>(ownC + off),
                kComputeRowsPerCore * kN);
            mm.SetTensorA(ag, false);
            mm.SetTensorB(wg, true);
            mm.SetOrgShape(kComputeRowsPerCore, kN, kK, kK, kN);
            mm.IterateAll(cg);
        }
        FlushCoreDCache(ownC + start + coreOff);
        ReadyTree(ibGm, ibUb, core);

        if (core == 0) {
            // 8MiB逻辑组拆2条4MiB消息，不放宽MemFabric单条信号长度。
            for (uint32_t part = 0; part < kE3PacketsPerGroup; ++part) {
                const uint64_t off = start +
                    static_cast<uint64_t>(part) * kE3PacketBytes;
                const uint32_t tag = k * kE3PacketsPerGroup + part;
                const bool ok = smem_shm_sdma_signal_at(
                    reserved, ownC + off, peerDst + off,
                    kE3PacketBytes, kTagBase | tag);
                CheckOrTrap(ok, status, 1);
            }
        }

        const bool doAdd = (overlap == 0 || k > 0);
        if (doAdd) {
            const uint32_t prev = overlap == 0 ? k : k - 1;
            if (core == 0) {
                E3WaitGroup(reserved, expectedRecvDst, prev, status, 2);
            }
            ReleaseAdd(ibGm, ibUb, core);
            const uint64_t base = static_cast<uint64_t>(prev) * chunkBytes + coreOff;
            // SDMA 写入了对端局部结果，精确失效本核即将读取的缓存行，
            // Graph 重放时同样不能省略。
            FlushCoreDCache(ownPeerC + base);
            GlobalTensor<float16_t> a, b, dst;
            a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                              perCoreBytes / 2);
            b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                              perCoreBytes / 2);
            dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                                perCoreBytes / 2);
            for (uint32_t off = 0; off < perCoreBytes / 2; off += kProductionAddTile) {
                LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
                LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
                DataCopy(la, a[off], kProductionAddTile);
                DataCopy(lb, b[off], kProductionAddTile);
                in0.EnQue(la); in1.EnQue(lb);
                LocalTensor<float16_t> va = in0.DeQue<float16_t>();
                LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
                LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
                Add(res, va, vb, kProductionAddTile);
                outQ.EnQue(res);
                LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
                DataCopy(dst[off], result, kProductionAddTile);
                outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
            }
        }
    }

    if (overlap != 0) {
        const uint32_t last = chunks - 1;
        if (core == 0) {
            E3WaitGroup(reserved, expectedRecvDst, last, status, 3);
        }
        ReleaseAdd(ibGm, ibUb, core);
        const uint64_t base = static_cast<uint64_t>(last) * chunkBytes +
                              static_cast<uint64_t>(core) * perCoreBytes;
        FlushCoreDCache(ownPeerC + base);
        GlobalTensor<float16_t> a, b, dst;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                          perCoreBytes / 2);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                          perCoreBytes / 2);
        dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                            perCoreBytes / 2);
        for (uint32_t off = 0; off < perCoreBytes / 2; off += kProductionAddTile) {
            LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
            LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
            DataCopy(la, a[off], kProductionAddTile);
            DataCopy(lb, b[off], kProductionAddTile);
            in0.EnQue(la); in1.EnQue(lb);
            LocalTensor<float16_t> va = in0.DeQue<float16_t>();
            LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
            LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
            Add(res, va, vb, kProductionAddTile);
            outQ.EnQue(res);
            LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
            DataCopy(dst[off], result, kProductionAddTile);
            outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
        }
    }

    WaitAddDone(ibGm, ibUb, core);
    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 4);
        // 双方均先发送 DONE 再等待；收到对端 DONE 表示
        // 对端 Add 已结束读取本端 C 缓冲区。
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ctrlSrc, peerCtrlDst, 8, kTagDone), status, 5);
        const auto done = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(done.status == SMEM_SHM_SDMA_MAIL_OK &&
            done.imm == kTagDone && done.len == 8 &&
            done.dst == expectedCtrlDst, status, 6);
    }
}

} // 正式 Kernel 内部命名空间
using namespace AscendC;
// 调用方应保证：
// 两个 Rank 的 CHUNK、数量、模式和对端指针一致；
// ownC 与 ownPeerC 是对称内存内不重叠区域；
// 本地 IB 工作区不小于 kIBBytes 且首次调用前清零；
// ctrlSrc 不可修改，peerCtrlDst 位于 C0/C1 区域外；
// y 与 C0/C1 不重叠，同一池不得并发使用；
// 本原型仅支持完整 CHUNK 倍数，最多 8192 行；
// 每个已实例化 Kernel 符号先进行两次 enable=0 预热。
extern "C" int mf310p_v2_e3_group2048_launch_async(
    uint64_t gva, uint64_t x, uint64_t w, uint64_t y,
    uint64_t ownC, uint64_t ownPeerC,
    uint64_t peerDst, uint64_t expectedRecvDst,
    uint64_t ibWorkspace, uint64_t status,
    uint64_t ctrlSrc, uint64_t peerCtrlDst, uint64_t expectedCtrlDst,
    uint32_t chunkRows, uint32_t chunks, uint32_t overlap,
    uint32_t enable, aclrtStream stream)
{
    if (stream == nullptr || (enable != 0 &&
        (gva == 0 || x == 0 || w == 0 || y == 0 || ownC == 0 ||
         ownPeerC == 0 || peerDst == 0 || expectedRecvDst == 0 ||
         ibWorkspace == 0 || status == 0 || ctrlSrc == 0 ||
         peerCtrlDst == 0 || expectedCtrlDst == 0))) return -1;
    // chunkRows是2048逻辑计算/同步组，mode作为MM_ROWS=1024/2048传入overlap参数。
    if (chunkRows != 2048 || chunks > 4 || (enable != 0 && chunks == 0) ||
        (overlap != 1024 && overlap != 2048)) return -1;
    if (overlap == 1024) {
        E3Group2048Kernel<tiling1024, 1024><<<kCores, 0, stream>>>(
            reinterpret_cast<uint8_t*>(gva), reinterpret_cast<uint8_t*>(x),
            reinterpret_cast<uint8_t*>(w), reinterpret_cast<uint8_t*>(y),
            reinterpret_cast<uint8_t*>(ownC), reinterpret_cast<uint8_t*>(ownPeerC),
            reinterpret_cast<uint8_t*>(peerDst), expectedRecvDst,
            reinterpret_cast<uint8_t*>(ibWorkspace),
            reinterpret_cast<uint8_t*>(status), reinterpret_cast<uint8_t*>(ctrlSrc),
            reinterpret_cast<uint8_t*>(peerCtrlDst), expectedCtrlDst,
            chunks, 1, enable);
    } else {
        E3Group2048Kernel<e3Tiling2048, 2048><<<kCores, 0, stream>>>(
            reinterpret_cast<uint8_t*>(gva), reinterpret_cast<uint8_t*>(x),
            reinterpret_cast<uint8_t*>(w), reinterpret_cast<uint8_t*>(y),
            reinterpret_cast<uint8_t*>(ownC), reinterpret_cast<uint8_t*>(ownPeerC),
            reinterpret_cast<uint8_t*>(peerDst), expectedRecvDst,
            reinterpret_cast<uint8_t*>(ibWorkspace),
            reinterpret_cast<uint8_t*>(status), reinterpret_cast<uint8_t*>(ctrlSrc),
            reinterpret_cast<uint8_t*>(peerCtrlDst), expectedCtrlDst,
            chunks, 1, enable);
    }
    return 0;
}
