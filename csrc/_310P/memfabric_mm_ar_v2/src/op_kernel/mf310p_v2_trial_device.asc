/*
 * EXPERIMENTAL V2: one AICore kernel owns MM, MemFabric exchange and Add.
 * 310P3 / dav-2002, TP=2, FP16, K=N=2048, weight FRACTAL_NZ.
 *
 * No torch routing: direct C launcher is deliberately opt-in.
 * Requires a symmetric C0/C1 region and independently allocated, zeroed
 * IB workspace. The first true launch requires two no-op symbol warmups.
 *
 * Reference: Ascend MatmulAllReduceCustom (MM tiling -> complete -> commit).
 * Transport is strictly public MemFabric signal/wait/quiet.
 */
#include <cstdint>
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "lib/matmul/matmul_intf.h"
#include "smem_shm_aicore_base_sdma.h"

namespace {

using namespace AscendC;
using AT = MatmulType<TPosition::GM, CubeFormat::ND, float16_t, false>;
using BT = MatmulType<TPosition::GM, CubeFormat::NZ, float16_t, true>;
using CT = MatmulType<TPosition::GM, CubeFormat::ND, float16_t, false>;
using BiasT = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;

constexpr uint32_t kCores = 8;
constexpr uint32_t kN = 2048, kK = 2048;
constexpr uint64_t kRowBytes = kN * sizeof(float16_t);
constexpr uint32_t kAddTile = 1024;
constexpr uint32_t kAddBytes = kAddTile * sizeof(float16_t);
constexpr uint64_t kTagBase = 0x4D46325600000000ULL;  // MF2V
constexpr uint64_t kTagDone = 0x4D463256444F4E45ULL;  // MF2VDONE
constexpr uint32_t kIBReady = 0;
constexpr uint32_t kIBDone = 1;
constexpr uint32_t kIBReleaseBase = 2;   // IDs 3..9 for cores 1..7
constexpr uint32_t kIBBytes = 8 * 32 * (kIBReleaseBase + 7) + 8 * 32;
constexpr uint32_t kUBForVector = 3 * kAddBytes;
constexpr uint32_t kUBForIB = 32;

constexpr MatmulQuantParams kQuant = {false, false};
constexpr MatmulBatchParams kBatch = {false, BatchMode::NONE};
constexpr MatmulFuncParams kFunc = {false, true, false, false, 0,
    IterateOrder::UNDEF, ScheduleType::INNER_PRODUCT, true, true};

#define V2_TILING(TAG, ROWS, BASIC)                                             \
    constexpr MatmulShapeParams shape##TAG = {ROWS / kCores, kN, kK,           \
        BASIC, 256, 64};                                                        \
    constexpr MatmulConfig cfg##TAG =                                          \
        GetMMConfig<MatmulConfigMode::CONFIG_NORM>(                             \
            shape##TAG, kQuant, kBatch, kFunc);                                 \
    constexpr static MatmulApiStaticTiling tiling##TAG =                        \
        GetMatmulApiTiling<AT, BT, CT, BiasT>(cfg##TAG, Impl::L1_SIZE);
V2_TILING(256, 256, 32)
V2_TILING(512, 512, 64)
V2_TILING(1024, 1024, 128)
#undef V2_TILING

__aicore__ inline void CleanLines(__gm__ uint8_t* p, uint64_t len)
{
    GlobalTensor<int32_t> g;
    for (uint64_t b = 0; b < len; b += 64) {
        g.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p + b), 16);
        DataCacheCleanAndInvalid<int32_t, CacheLine::SINGLE_CACHE_LINE>(g);
    }
}

__aicore__ inline void CheckOrTrap(bool ok, __gm__ uint8_t* status, uint64_t code)
{
    if (ok) return;
    *reinterpret_cast<__gm__ volatile uint64_t*>(status) = code;
    CleanLines(status, 64);
    Trap();
}

/*
 * Per-core 64B-aligned result slot + explicit line clean. dav-2002 AI cores
 * have no inter-core L1 coherence: concurrent scalar stores into one shared
 * 32B buffer lose writes at L1 writeback (measured: nondeterministic subsets
 * of probe results missing). V1's ready cells use the same 64B discipline.
 */
__aicore__ inline void WriteResultSlot(
    __gm__ uint8_t* result, uint32_t core, uint32_t value)
{
    __gm__ uint8_t* slot = result + 64ULL * core;
    *reinterpret_cast<__gm__ volatile uint32_t*>(slot) = value;
    GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(slot), 8);
    DataCacheCleanAndInvalid<int32_t, CacheLine::SINGLE_CACHE_LINE>(g);
}

/*
 * 8 -> 1: each worker posts its own event 0; core0 waits for cores 1..7.
 * 1 -> 7: core0 posts seven distinct eventIDs, each consumed by ONE core.
 * Event 1: final Add-done from workers; all events are consumed per call.
 * IB GM must be pre-zeroed, and the 310P AICORE mode probed before use.
 */
__aicore__ inline void WaitReady(
    const GlobalTensor<int32_t>& ibGm, const LocalTensor<int32_t>& ibUb,
    uint32_t core)
{
    if (core != 0) {
        IBSet<true>(ibGm, ibUb, core, kIBReady);
        return;
    }
    for (uint32_t b = 1; b < kCores; ++b) {
        IBWait<true>(ibGm, ibUb, b, kIBReady);
    }
}

__aicore__ inline void ReleaseAdd(
    const GlobalTensor<int32_t>& ibGm, const LocalTensor<int32_t>& ibUb,
    uint32_t core)
{
    if (core == 0) {
        for (uint32_t b = 1; b < kCores; ++b) {
            IBSet<true>(ibGm, ibUb, 0, kIBReleaseBase + b);
        }
    } else {
        IBWait<true>(ibGm, ibUb, 0, kIBReleaseBase + core);
    }
}

__aicore__ inline void WaitAddDone(
    const GlobalTensor<int32_t>& ibGm, const LocalTensor<int32_t>& ibUb,
    uint32_t core)
{
    if (core != 0) {
        IBSet<true>(ibGm, ibUb, core, kIBDone);
    } else {
        for (uint32_t b = 1; b < kCores; ++b)
            IBWait<true>(ibGm, ibUb, b, kIBDone);
    }
}

template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2TrialKernel(
    __gm__ uint8_t* gva,
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    __gm__ uint8_t* ownC, __gm__ uint8_t* ownPeerC,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* status,
    __gm__ uint8_t* ctrlSrc, __gm__ uint8_t* peerCtrlDst,
    uint64_t expectedCtrlDst,
    uint32_t chunks, uint32_t overlap, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (enable == 0 || chunks == 0) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;

    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
                         kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = syncBuf.Get<int32_t>();

    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    const uint64_t perCoreBytes = CHUNK * kRowBytes / kCores;
    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t chunkBytes = CHUNK * kRowBytes;
    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);

    for (uint32_t k = 0; k < chunks; ++k) {
        const uint64_t start = static_cast<uint64_t>(k) * chunkBytes;
        const uint64_t coreOff = static_cast<uint64_t>(core) * perCoreBytes;
        GlobalTensor<float16_t> ag, cg;
        ag.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(x + start + coreOff),
            rowsPerCore * kK);
        cg.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(ownC + start + coreOff),
            rowsPerCore * kN);
        mm.SetTensorA(ag, false);
        mm.SetTensorB(wg, true);
        mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
        mm.IterateAll(cg);
        CleanLines(ownC + start + coreOff, perCoreBytes);
        WaitReady(ibGm, ibUb, core);

        if (core == 0) {
            const bool ok = smem_shm_sdma_signal_at(
                reserved, ownC + start, peerDst + start,
                chunkBytes, kTagBase | k);
            CheckOrTrap(ok, status, 1);
        }

        const bool doAdd = (overlap == 0 || k > 0);
        if (doAdd) {
            const uint32_t prev = overlap == 0 ? k : k - 1;
            if (core == 0) {
                auto mail = smem_shm_sdma_wait_at(reserved);
                const bool good =
                    mail.status == SMEM_SHM_SDMA_MAIL_OK &&
                    mail.dst == expectedRecvDst + static_cast<uint64_t>(prev) * chunkBytes &&
                    mail.len == chunkBytes && mail.imm == (kTagBase | prev);
                CheckOrTrap(good, status, 2);
            }
            ReleaseAdd(ibGm, ibUb, core);
            const uint64_t base = static_cast<uint64_t>(prev) * chunkBytes + coreOff;
            // SDMA wrote the peer's partial output: invalidate exactly the
            // rows this core will consume, including on Graph replay.
            CleanLines(ownPeerC + base, perCoreBytes);
            GlobalTensor<float16_t> a, b, dst;
            a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                              perCoreBytes / 2);
            b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                              perCoreBytes / 2);
            dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                                perCoreBytes / 2);
            for (uint32_t off = 0; off < perCoreBytes / 2; off += kAddTile) {
                LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
                LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
                DataCopy(la, a[off], kAddTile);
                DataCopy(lb, b[off], kAddTile);
                in0.EnQue(la); in1.EnQue(lb);
                LocalTensor<float16_t> va = in0.DeQue<float16_t>();
                LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
                LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
                Add(res, va, vb, kAddTile);
                outQ.EnQue(res);
                LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
                DataCopy(dst[off], result, kAddTile);
                outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
            }
        }
    }

    if (overlap != 0) {
        const uint32_t last = chunks - 1;
        if (core == 0) {
            auto mail = smem_shm_sdma_wait_at(reserved);
            CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
                mail.dst == expectedRecvDst + static_cast<uint64_t>(last) * chunkBytes &&
                mail.len == chunkBytes && mail.imm == (kTagBase | last),
                status, 3);
        }
        ReleaseAdd(ibGm, ibUb, core);
        const uint64_t base = static_cast<uint64_t>(last) * chunkBytes +
                              static_cast<uint64_t>(core) * perCoreBytes;
        CleanLines(ownPeerC + base, perCoreBytes);
        GlobalTensor<float16_t> a, b, dst;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                          perCoreBytes / 2);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                          perCoreBytes / 2);
        dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                            perCoreBytes / 2);
        for (uint32_t off = 0; off < perCoreBytes / 2; off += kAddTile) {
            LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
            LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
            DataCopy(la, a[off], kAddTile);
            DataCopy(lb, b[off], kAddTile);
            in0.EnQue(la); in1.EnQue(lb);
            LocalTensor<float16_t> va = in0.DeQue<float16_t>();
            LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
            LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
            Add(res, va, vb, kAddTile);
            outQ.EnQue(res);
            LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
            DataCopy(dst[off], result, kAddTile);
            outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
        }
    }

    WaitAddDone(ibGm, ibUb, core);
    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 4);
        // Both ranks signal DONE before waiting. The peer's DONE implies
        // it has finished reading our local C via its Add operation.
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ctrlSrc, peerCtrlDst, 8, kTagDone), status, 5);
        const auto done = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(done.status == SMEM_SHM_SDMA_MAIL_OK &&
            done.imm == kTagDone && done.len == 8 &&
            done.dst == expectedCtrlDst, status, 6);
    }
}

/* ---- staged diagnostics (test scaffolding, not part of the protocol) ---- */

/* Diag A: local per-core M-split MM of one chunk straight into y.
 * Validates tiling/UB/NZ-weight handling without any communication. */
template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagMmKernel(
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;
    TPipe pipe;
    TBuf<> mmUb;
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE);  /* diag: full UB like V1 */
    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t coreOff =
        static_cast<uint64_t>(core) * rowsPerCore * kRowBytes;
    GlobalTensor<float16_t> ag, cg;
    ag.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(x + coreOff), rowsPerCore * kK);
    cg.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(y + coreOff), rowsPerCore * kN);
    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    mm.SetTensorA(ag, false);
    mm.SetTensorB(wg, true);
    mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
    mm.IterateAll(cg);
}

/* Diag C: MM into ownC + full exchange of chunk 0 + Add, but WITHOUT the
 * inter-core IB rendezvous: core0 signals after its own MM+clean only and
 * consumes one mail; every core then adds its slice. Isolates the SDMA
 * data path from the official-IB scheduling. */
template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagNoIbKernel(
    __gm__ uint8_t* gva,
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    __gm__ uint8_t* ownC, __gm__ uint8_t* ownPeerC,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* status, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;
    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t perCoreBytes =
        static_cast<uint64_t>(rowsPerCore) * kRowBytes;
    const uint64_t chunkBytes =
        static_cast<uint64_t>(CHUNK) * kRowBytes;
    const uint64_t coreOff = static_cast<uint64_t>(core) * perCoreBytes;
    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);

    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    GlobalTensor<float16_t> ag, cg;
    ag.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(x + coreOff), rowsPerCore * kK);
    cg.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(ownC + coreOff), rowsPerCore * kN);
    mm.SetTensorA(ag, false);
    mm.SetTensorB(wg, true);
    mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
    mm.IterateAll(cg);
    CleanLines(ownC + coreOff, perCoreBytes);

    if (core == 0) {
        const bool ok = smem_shm_sdma_signal_at(
            reserved, ownC, peerDst, chunkBytes, kTagBase);
        CheckOrTrap(ok, status, 1);
        auto mail = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
            mail.dst == expectedRecvDst &&
            mail.len == chunkBytes && mail.imm == kTagBase, status, 2);
    }
    const uint64_t base = coreOff;
    CleanLines(ownPeerC + base, perCoreBytes);
    GlobalTensor<float16_t> a, b, dst;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                      perCoreBytes / 2);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                      perCoreBytes / 2);
    dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                        perCoreBytes / 2);
    for (uint32_t off = 0; off < perCoreBytes / 2; off += kAddTile) {
        LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
        LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
        DataCopy(la, a[off], kAddTile);
        DataCopy(lb, b[off], kAddTile);
        in0.EnQue(la); in1.EnQue(lb);
        LocalTensor<float16_t> va = in0.DeQue<float16_t>();
        LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
        LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
        Add(res, va, vb, kAddTile);
        outQ.EnQue(res);
        LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
        DataCopy(dst[off], result, kAddTile);
        outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
    }
    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 4);
    }
}


/* Diag IB: the noib pipeline plus the official inter-core rendezvous
 * (WaitReady / ReleaseAdd / WaitAddDone) around each chunk - no DONE mail. */
template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagIbKernel(
    __gm__ uint8_t* gva,
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    __gm__ uint8_t* ownC, __gm__ uint8_t* ownPeerC,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* status, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;
    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
                         kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = syncBuf.Get<int32_t>();
    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t perCoreBytes =
        static_cast<uint64_t>(rowsPerCore) * kRowBytes;
    const uint64_t chunkBytes = static_cast<uint64_t>(CHUNK) * kRowBytes;
    const uint64_t coreOff = static_cast<uint64_t>(core) * perCoreBytes;
    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);

    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    GlobalTensor<float16_t> ag, cg;
    ag.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(x + coreOff), rowsPerCore * kK);
    cg.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(ownC + coreOff), rowsPerCore * kN);
    mm.SetTensorA(ag, false);
    mm.SetTensorB(wg, true);
    mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
    mm.IterateAll(cg);
    CleanLines(ownC + coreOff, perCoreBytes);

    WaitReady(ibGm, ibUb, core);
    if (core == 0) {
        const bool ok = smem_shm_sdma_signal_at(
            reserved, ownC, peerDst, chunkBytes, kTagBase);
        CheckOrTrap(ok, status, 1);
        auto mail = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
            mail.dst == expectedRecvDst &&
            mail.len == chunkBytes && mail.imm == kTagBase, status, 2);
    }
    ReleaseAdd(ibGm, ibUb, core);
    const uint64_t base = coreOff;
    CleanLines(ownPeerC + base, perCoreBytes);
    GlobalTensor<float16_t> a, b, dst;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                      perCoreBytes / 2);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                      perCoreBytes / 2);
    dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                        perCoreBytes / 2);
    for (uint32_t off = 0; off < perCoreBytes / 2; off += kAddTile) {
        LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
        LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
        DataCopy(la, a[off], kAddTile);
        DataCopy(lb, b[off], kAddTile);
        in0.EnQue(la); in1.EnQue(lb);
        LocalTensor<float16_t> va = in0.DeQue<float16_t>();
        LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
        LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
        Add(res, va, vb, kAddTile);
        outQ.EnQue(res);
        LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
        DataCopy(dst[off], result, kAddTile);
        outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
    }
    WaitAddDone(ibGm, ibUb, core);
    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 4);
    }
}

/* Diag IBDONE16: IbDone body with the trial kernel's 16-arg signature
 * (chunks/overlap added, straight-line body) - isolates arg-count effects. */
template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagIbDone16Kernel(
    __gm__ uint8_t* gva,
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    __gm__ uint8_t* ownC, __gm__ uint8_t* ownPeerC,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* status,
    __gm__ uint8_t* ctrlSrc, __gm__ uint8_t* peerCtrlDst,
    uint64_t expectedCtrlDst,
    uint32_t chunks, uint32_t overlap, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (enable == 0 || chunks == 0) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;
    (void)overlap;
    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
                         kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = syncBuf.Get<int32_t>();
    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t perCoreBytes =
        static_cast<uint64_t>(rowsPerCore) * kRowBytes;
    const uint64_t chunkBytes = static_cast<uint64_t>(CHUNK) * kRowBytes;
    const uint64_t coreOff = static_cast<uint64_t>(core) * perCoreBytes;
    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);

    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    GlobalTensor<float16_t> ag, cg;
    ag.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(x + coreOff), rowsPerCore * kK);
    cg.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(ownC + coreOff), rowsPerCore * kN);
    mm.SetTensorA(ag, false);
    mm.SetTensorB(wg, true);
    mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
    mm.IterateAll(cg);
    CleanLines(ownC + coreOff, perCoreBytes);

    WaitReady(ibGm, ibUb, core);
    if (core == 0) {
        const bool ok = smem_shm_sdma_signal_at(
            reserved, ownC, peerDst, chunkBytes, kTagBase);
        CheckOrTrap(ok, status, 1);
        auto mail = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
            mail.dst == expectedRecvDst &&
            mail.len == chunkBytes && mail.imm == kTagBase, status, 2);
    }
    ReleaseAdd(ibGm, ibUb, core);
    const uint64_t base = coreOff;
    CleanLines(ownPeerC + base, perCoreBytes);
    GlobalTensor<float16_t> a, b, dst;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                      perCoreBytes / 2);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                      perCoreBytes / 2);
    dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                        perCoreBytes / 2);
    for (uint32_t off = 0; off < perCoreBytes / 2; off += kAddTile) {
        LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
        LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
        DataCopy(la, a[off], kAddTile);
        DataCopy(lb, b[off], kAddTile);
        in0.EnQue(la); in1.EnQue(lb);
        LocalTensor<float16_t> va = in0.DeQue<float16_t>();
        LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
        LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
        Add(res, va, vb, kAddTile);
        outQ.EnQue(res);
        LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
        DataCopy(dst[off], result, kAddTile);
        outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
    }
    WaitAddDone(ibGm, ibUb, core);
    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 4);
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ctrlSrc, peerCtrlDst, 8, kTagDone), status, 5);
        const auto done = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(done.status == SMEM_SHM_SDMA_MAIL_OK &&
            done.imm == kTagDone && done.len == 8 &&
            done.dst == expectedCtrlDst, status, 6);
    }
}

/* Diag LOOP: IbDone16 body wrapped in the trial kernel's chunk loop
 * (no overlap logic). Isolates the loop construct as the trigger. */
template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagLoopKernel(
    __gm__ uint8_t* gva,
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    __gm__ uint8_t* ownC, __gm__ uint8_t* ownPeerC,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* status,
    __gm__ uint8_t* ctrlSrc, __gm__ uint8_t* peerCtrlDst,
    uint64_t expectedCtrlDst,
    uint32_t chunks, uint32_t overlap, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (enable == 0 || chunks == 0) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;
    (void)overlap;
    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
                         kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = syncBuf.Get<int32_t>();
    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t perCoreBytes =
        static_cast<uint64_t>(rowsPerCore) * kRowBytes;
    const uint64_t chunkBytes = static_cast<uint64_t>(CHUNK) * kRowBytes;
    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);
    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);

    for (uint32_t k = 0; k < chunks; ++k) {
        const uint64_t start = static_cast<uint64_t>(k) * chunkBytes;
        const uint64_t coreOff =
            static_cast<uint64_t>(core) * perCoreBytes;
        GlobalTensor<float16_t> ag, cg;
        ag.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(x + start + coreOff),
            rowsPerCore * kK);
        cg.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(ownC + start + coreOff),
            rowsPerCore * kN);
        mm.SetTensorA(ag, false);
        mm.SetTensorB(wg, true);
        mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
        mm.IterateAll(cg);
        CleanLines(ownC + start + coreOff, perCoreBytes);
        WaitReady(ibGm, ibUb, core);
        if (core == 0) {
            const bool ok = smem_shm_sdma_signal_at(
                reserved, ownC + start, peerDst + start, chunkBytes,
                kTagBase | k);
            CheckOrTrap(ok, status, 1);
            auto mail = smem_shm_sdma_wait_at(reserved);
            CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
                mail.dst == expectedRecvDst + start &&
                mail.len == chunkBytes && mail.imm == (kTagBase | k),
                status, 2);
        }
        ReleaseAdd(ibGm, ibUb, core);
        const uint64_t base = start + coreOff;
        CleanLines(ownPeerC + base, perCoreBytes);
        GlobalTensor<float16_t> a, b, dst;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                          perCoreBytes / 2);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                          perCoreBytes / 2);
        dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                            perCoreBytes / 2);
        for (uint32_t off = 0; off < perCoreBytes / 2; off += kAddTile) {
            LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
            LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
            DataCopy(la, a[off], kAddTile);
            DataCopy(lb, b[off], kAddTile);
            in0.EnQue(la); in1.EnQue(lb);
            LocalTensor<float16_t> va = in0.DeQue<float16_t>();
            LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
            LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
            Add(res, va, vb, kAddTile);
            outQ.EnQue(res);
            LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
            DataCopy(dst[off], result, kAddTile);
            outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
        }
    }
    WaitAddDone(ibGm, ibUb, core);
    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 4);
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ctrlSrc, peerCtrlDst, 8, kTagDone), status, 5);
        const auto done = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(done.status == SMEM_SHM_SDMA_MAIL_OK &&
            done.imm == kTagDone && done.len == 8 &&
            done.dst == expectedCtrlDst, status, 6);
    }
}

/* Diag IBDONE: diag IB plus the symmetric DONE-mail handshake. */
template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagIbDoneKernel(
    __gm__ uint8_t* gva,
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    __gm__ uint8_t* ownC, __gm__ uint8_t* ownPeerC,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* status,
    __gm__ uint8_t* ctrlSrc, __gm__ uint8_t* peerCtrlDst,
    uint64_t expectedCtrlDst, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;
    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
                         kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = syncBuf.Get<int32_t>();
    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t perCoreBytes =
        static_cast<uint64_t>(rowsPerCore) * kRowBytes;
    const uint64_t chunkBytes = static_cast<uint64_t>(CHUNK) * kRowBytes;
    const uint64_t coreOff = static_cast<uint64_t>(core) * perCoreBytes;
    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);

    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    GlobalTensor<float16_t> ag, cg;
    ag.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(x + coreOff), rowsPerCore * kK);
    cg.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(ownC + coreOff), rowsPerCore * kN);
    mm.SetTensorA(ag, false);
    mm.SetTensorB(wg, true);
    mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
    mm.IterateAll(cg);
    CleanLines(ownC + coreOff, perCoreBytes);

    WaitReady(ibGm, ibUb, core);
    if (core == 0) {
        const bool ok = smem_shm_sdma_signal_at(
            reserved, ownC, peerDst, chunkBytes, kTagBase);
        CheckOrTrap(ok, status, 1);
        auto mail = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
            mail.dst == expectedRecvDst &&
            mail.len == chunkBytes && mail.imm == kTagBase, status, 2);
    }
    ReleaseAdd(ibGm, ibUb, core);
    const uint64_t base = coreOff;
    CleanLines(ownPeerC + base, perCoreBytes);
    GlobalTensor<float16_t> a, b, dst;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                      perCoreBytes / 2);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                      perCoreBytes / 2);
    dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                        perCoreBytes / 2);
    for (uint32_t off = 0; off < perCoreBytes / 2; off += kAddTile) {
        LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
        LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
        DataCopy(la, a[off], kAddTile);
        DataCopy(lb, b[off], kAddTile);
        in0.EnQue(la); in1.EnQue(lb);
        LocalTensor<float16_t> va = in0.DeQue<float16_t>();
        LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
        LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
        Add(res, va, vb, kAddTile);
        outQ.EnQue(res);
        LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
        DataCopy(dst[off], result, kAddTile);
        outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
    }
    WaitAddDone(ibGm, ibUb, core);
    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 4);
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ctrlSrc, peerCtrlDst, 8, kTagDone), status, 5);
        const auto done = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(done.status == SMEM_SHM_SDMA_MAIL_OK &&
            done.imm == kTagDone && done.len == 8 &&
            done.dst == expectedCtrlDst, status, 6);
    }
}

template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagV1MmKernel(
    __gm__ uint8_t* xGm, __gm__ uint8_t* wGm, __gm__ uint8_t* yGm,
    uint32_t generation)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (generation == 0) return;
    const uint32_t block = GetBlockIdx();
    if (block >= kCores) return;

    constexpr uint32_t kRowsPerCore = CHUNK / kCores;
    const uint64_t rowOff = static_cast<uint64_t>(block) * kRowsPerCore;

    TPipe pipe;
    TCubeTiling rt{};
    rt.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &rt);
    TBuf<> ubBuf;
    pipe.InitBuffer(ubBuf, TOTAL_UB_SIZE);
    mm.SetLocalWorkspace(ubBuf.Get<uint8_t>());

    GlobalTensor<float16_t> aGm;
    GlobalTensor<float16_t> bGm;
    GlobalTensor<float16_t> cGm;
    aGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(xGm) + rowOff * kK,
        kRowsPerCore * kK);
    bGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(wGm), kN * kK);
    cGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(
            yGm + rowOff * kN * sizeof(float16_t)),
        kRowsPerCore * kN);

    mm.SetTensorA(aGm, false);
    mm.SetTensorB(bGm, true);
    mm.SetOrgShape(kRowsPerCore, kN, kK, kK, kN);
    mm.IterateAll(cGm);
}


/* T1: MatmulBlock-style N partition using ORIGINAL NZ B and DIRECT ND C.
 * Unlike V1 small-M, there is NO sliced-B allocation, input staging or
 * blocked-C-to-ND scatter. The caller's M is exact (1..256).
 *
 * The official MatmulBlock B(NZ, transposed) offset is colOffset*16 FP16
 * elements; C(ND) offset is colOffset. SetOrgShape(..., orgKc=2048)
 * preserves full ND row pitch for per-core C partials. G0 must validate
 * exact-M SetSingleShape and NZ subviews on dav-2002 before use.
 */
constexpr uint64_t kDirectSmallTag = 0x4D4632564E5A4E44ULL; // MF2VN ZND
template <uint32_t T, uint32_t MM_CORES>
struct DirectNsplit {
    static constexpr uint32_t NC = kN / MM_CORES;
    /* dav-2002 measured contract: for ND C at GM with enableUBReuse the
     * matmul NZ2ND copy-out stages at local-workspace offset
     * transLength = basicM*basicN*sizeof(fp16) and needs 2x transLength
     * total. basicM=256 x basicN=256 requires 256KB, which cannot coexist
     * with this kernel's 6KB Add/IB UB reservations in the 256KB UB; the
     * release build compiles out the ASCENDC_ASSERT and full basic blocks
     * fault with "MTE read on-chip buffer out of bounds" (m=256 == T).
     * Cap basicM at the T0-proven 128 so T=256 runs two 128-row M blocks. */
    static constexpr uint32_t BASIC_M = T < 128 ? T : 128;
    static constexpr MatmulShapeParams shape =
        {T, NC, kK, BASIC_M, 256, 64};
    static constexpr MatmulConfig cfg =
        GetMMConfig<MatmulConfigMode::CONFIG_NORM>(
            shape, kQuant, kBatch, kFunc);
    static constexpr MatmulApiStaticTiling tiling =
        GetMatmulApiTiling<AT, BT, CT, BiasT>(cfg, Impl::L1_SIZE);
};

template <uint32_t T, uint32_t MM_CORES>
__global__ __aicore__ void V2NzDirectSmallKernel(
    __gm__ uint8_t* gva, __gm__ uint8_t* x, __gm__ uint8_t* w,
    __gm__ uint8_t* y, __gm__ uint8_t* ownC,
    __gm__ uint8_t* ownPeerC, __gm__ uint8_t* peerDst,
    uint64_t expectedRecvDst, __gm__ uint8_t* ibWorkspace,
    __gm__ uint8_t* status, __gm__ uint8_t* ctrlSrc,
    __gm__ uint8_t* peerCtrlDst, uint64_t expectedCtrlDst,
    uint32_t m, uint32_t addCores, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable || m == 0) return;
    constexpr uint32_t NC = kN / MM_CORES;
    const uint32_t core = GetBlockIdx();
    if (core >= MM_CORES && core >= addCores) return;
    const uint32_t blockCols = core * NC;
    const uint64_t chunkBytes = static_cast<uint64_t>(m) * kRowBytes;

    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
        kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = syncBuf.Get<int32_t>();

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    if (core < MM_CORES) {
        // Only MM participant cores construct a Matmul object. Other
        // Add-only cores may have core >= MM_CORES, but they never touch
        // the MM tiling state or its local workspace.
        TCubeTiling runtime{};
        runtime.usedCoreNum = MM_CORES;
        Matmul<AT, BT, CT, BiasT, DirectNsplit<T, MM_CORES>::tiling> mm;
        REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
        mm.SetLocalWorkspace(mmUb.Get<uint8_t>());
        GlobalTensor<float16_t> a, b, c;
        a.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(x),
            static_cast<uint64_t>(m) * kK);
        // B is in V1-verified [K/16][N/16][16*16 FP16] NZ order.
        // The transpose-B NZ column offset is nIndex * BLOCK_CUBE(16).
        const uint64_t nzElements =
            static_cast<uint64_t>(blockCols) * 16;
        b.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(w) + nzElements,
            static_cast<uint64_t>(kN) * kK - nzElements);
        c.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(ownC) + blockCols,
            static_cast<uint64_t>(m) * kN - blockCols);

        // orgN=2048 describes B's ORIGINAL NZ K-block pitch.
        // orgKc=2048 describes direct output ND row pitch.
        // This must precede both SetTensorB and SetSingleShape.
        mm.SetOrgShape(m, kN, kK, kK, kN);
        mm.SetSingleShape(m, NC, kK);
        mm.SetTensorA(a, false);
        mm.SetTensorB(b, true);
        mm.IterateAll(c);
        // Each AI Core cleans only the [M,NC] stripes it actually wrote.
        // For MM_CORES=8 a stripe is 512B and cache-line disjoint.
        for (uint32_t row = 0; row < m; ++row) {
            CleanLines(ownC + static_cast<uint64_t>(row) * kRowBytes +
                           blockCols * sizeof(float16_t),
                       static_cast<uint64_t>(NC) * sizeof(float16_t));
        }
        if (core != 0) {
            IBSet<true>(ibGm, ibUb, core, kIBReady);
        }
    }

    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);
    if (core == 0) {
        for (uint32_t bcore = 1; bcore < MM_CORES; ++bcore) {
            IBWait<true>(ibGm, ibUb, bcore, kIBReady);
        }
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ownC, peerDst, chunkBytes, kDirectSmallTag),
            status, 41);
        const auto mail = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
                        mail.dst == expectedRecvDst &&
                        mail.len == chunkBytes &&
                        mail.imm == kDirectSmallTag,
                    status, 42);
        for (uint32_t bcore = 1; bcore < addCores; ++bcore) {
            IBSet<true>(ibGm, ibUb, 0, kIBReleaseBase + bcore);
        }
    } else if (core < addCores) {
        IBWait<true>(ibGm, ibUb, 0, kIBReleaseBase + core);
    }

    if (core < addCores) {
        // Add is independent from MM core partition. Each worker owns
        // entire output rows, avoiding any write-line sharing.
        for (uint32_t row = core; row < m; row += addCores) {
            const uint64_t rowOffset = static_cast<uint64_t>(row) * kRowBytes;
            CleanLines(ownPeerC + rowOffset, kRowBytes);
            GlobalTensor<float16_t> a, b, dst;
            a.SetGlobalBuffer(
                reinterpret_cast<__gm__ float16_t*>(ownC + rowOffset), kN);
            b.SetGlobalBuffer(
                reinterpret_cast<__gm__ float16_t*>(ownPeerC + rowOffset), kN);
            dst.SetGlobalBuffer(
                reinterpret_cast<__gm__ float16_t*>(y + rowOffset), kN);
            for (uint32_t col = 0; col < kN; col += kAddTile) {
                LocalTensor<float16_t> lhs = in0.AllocTensor<float16_t>();
                LocalTensor<float16_t> rhs = in1.AllocTensor<float16_t>();
                DataCopy(lhs, a[col], kAddTile);
                DataCopy(rhs, b[col], kAddTile);
                in0.EnQue(lhs); in1.EnQue(rhs);
                LocalTensor<float16_t> la = in0.DeQue<float16_t>();
                LocalTensor<float16_t> lb = in1.DeQue<float16_t>();
                LocalTensor<float16_t> sum = outQ.AllocTensor<float16_t>();
                Add(sum, la, lb, kAddTile);
                outQ.EnQue(sum);
                LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
                DataCopy(dst[col], result, kAddTile);
                outQ.FreeTensor(result);
                in0.FreeTensor(la); in1.FreeTensor(lb);
            }
        }
        if (core != 0) {
            IBSet<true>(ibGm, ibUb, core, kIBDone);
        }
    }
    if (core == 0) {
        for (uint32_t bcore = 1; bcore < addCores; ++bcore) {
            IBWait<true>(ibGm, ibUb, bcore, kIBDone);
        }
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 43);
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ctrlSrc, peerCtrlDst, 8, kTagDone), status, 44);
        const auto done = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(done.status == SMEM_SHM_SDMA_MAIL_OK &&
                        done.dst == expectedCtrlDst &&
                        done.len == 8 && done.imm == kTagDone,
                    status, 45);
    }
}

/* T1 diag: ONLY the N-split MM stage of V2NzDirectSmallKernel, writing the
 * per-core [m,NC] stripe straight into the final ND y (no symmetric region,
 * no MemFabric, no IB, no Add). Buffer layout mirrors the production kernel
 * (same syncBuf/Add-queue reservations) so UB partitioning is identical.
 * Single-card isolation of the original-NZ subview + direct-ND SetOrgShape /
 * SetSingleShape contract on dav-2002. */
template <uint32_t T, uint32_t MM_CORES>
__global__ __aicore__ void V2DiagNzDirectMmKernel(
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    uint32_t m, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable || m == 0) return;
    constexpr uint32_t NC = kN / MM_CORES;
    const uint32_t core = GetBlockIdx();
    if (core >= MM_CORES) return;
    const uint32_t blockCols = core * NC;

    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    TCubeTiling runtime{};
    runtime.usedCoreNum = MM_CORES;
    Matmul<AT, BT, CT, BiasT, DirectNsplit<T, MM_CORES>::tiling> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    GlobalTensor<float16_t> a, b, c;
    a.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(x),
        static_cast<uint64_t>(m) * kK);
    const uint64_t nzElements =
        static_cast<uint64_t>(blockCols) * 16;
    b.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(w) + nzElements,
        static_cast<uint64_t>(kN) * kK - nzElements);
    c.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(y) + blockCols,
        static_cast<uint64_t>(m) * kN - blockCols);
    mm.SetOrgShape(m, kN, kK, kK, kN);
    mm.SetSingleShape(m, NC, kK);
    mm.SetTensorA(a, false);
    mm.SetTensorB(b, true);
    mm.IterateAll(c);
    /* Mirror the production kernel's post-MM cache discipline so the diag
     * observes the same GM state the SDMA/Add engines would see. */
    for (uint32_t row = 0; row < m; ++row) {
        CleanLines(y + static_cast<uint64_t>(row) * kRowBytes +
                       blockCols * sizeof(float16_t),
                   static_cast<uint64_t>(NC) * sizeof(float16_t));
    }
}

} // anonymous namespace

// Public C launch wrappers and standalone probe use AscendC names as well.
using namespace AscendC;

// Caller must ensure:
//   * BOTH ranks call with identical CHUNK/chunks/mode and valid peer pointers;
//   * ownC and ownPeerC are disjoint portions of its symmetric window;
//   * the local IB workspace (>= kIBBytes) was zeroed before first use;
//   * ctrlSrc is immutable and peerCtrlDst lies outside C0/C1;
//   * y is distinct from both C buffers; no concurrent use of the same pool;
//   * this is prototype geometry only: full CHUNK multiples, <=8192 rows;
//   * warm each instantiated kernel symbol twice with enable=0.
extern "C" int mf310p_v2_trial_launch_async(
    uint64_t gva, uint64_t x, uint64_t w, uint64_t y,
    uint64_t ownC, uint64_t ownPeerC,
    uint64_t peerDst, uint64_t expectedRecvDst,
    uint64_t ibWorkspace, uint64_t status,
    uint64_t ctrlSrc, uint64_t peerCtrlDst, uint64_t expectedCtrlDst,
    uint32_t chunkRows, uint32_t chunks, uint32_t overlap,
    uint32_t enable, aclrtStream stream)
{
    if (stream == nullptr || (enable != 0 &&
        (gva == 0 || x == 0 || w == 0 || y == 0 || ownC == 0 ||
         ownPeerC == 0 || peerDst == 0 || expectedRecvDst == 0 ||
         ibWorkspace == 0 || status == 0 || ctrlSrc == 0 ||
         peerCtrlDst == 0 || expectedCtrlDst == 0))) return -1;
    if (chunkRows == 0 || chunks > 8192 / chunkRows || (enable != 0 && chunks == 0) ||
        overlap > 1) return -1;
#define V2_CASE(ROWS)                                                         \
    case ROWS: {                                                              \
        V2TrialKernel<tiling##ROWS, ROWS><<<kCores, 0, stream>>>(              \
            reinterpret_cast<uint8_t*>(gva),                                 \
            reinterpret_cast<uint8_t*>(x),                                   \
            reinterpret_cast<uint8_t*>(w),                                   \
            reinterpret_cast<uint8_t*>(y),                                   \
            reinterpret_cast<uint8_t*>(ownC),                                \
            reinterpret_cast<uint8_t*>(ownPeerC),                             \
            reinterpret_cast<uint8_t*>(peerDst), expectedRecvDst,             \
            reinterpret_cast<uint8_t*>(ibWorkspace),                          \
            reinterpret_cast<uint8_t*>(status),                               \
            reinterpret_cast<uint8_t*>(ctrlSrc),                              \
            reinterpret_cast<uint8_t*>(peerCtrlDst), expectedCtrlDst,         \
            chunks, overlap, enable);                                        \
        return 0;                                                             \
    }
    switch (chunkRows) {
        V2_CASE(256)
        V2_CASE(512)
        V2_CASE(1024)
        default: return -1;
    }
#undef V2_CASE
}

extern "C" uint32_t mf310p_v2_trial_ib_workspace_bytes()
{
    return kIBBytes;
}

/* Standalone official-IB contract probe. Must pass BEFORE V2TrialKernel. */
extern "C" __global__ __aicore__ void mf310p_v2_ib_probe_kernel(
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* result,
    uint32_t repetitions, uint32_t enabled)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enabled || GetBlockIdx() >= 2) return;
    TPipe pipe;
    TBuf<> syncBuf;
    pipe.InitBuffer(syncBuf, 32);
    GlobalTensor<int32_t> gm;
    gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace), 640);
    LocalTensor<int32_t> ub = syncBuf.Get<int32_t>();
    for (uint32_t k = 0; k < repetitions; ++k) {
        if (GetBlockIdx() == 0) {
            IBSet<true>(gm, ub, 0, 0);
            IBWait<true>(gm, ub, 1, 1);
        } else {
            IBWait<true>(gm, ub, 0, 0);
            IBSet<true>(gm, ub, 1, 1);
        }
    }
    WriteResultSlot(result, GetBlockIdx(), repetitions);
}
extern "C" int mf310p_v2_ib_probe_async(
    uint64_t ibWorkspace, uint64_t result, uint32_t repetitions,
    uint32_t enabled, aclrtStream stream)
{
    if (!stream || (enabled && (!ibWorkspace || !result || !repetitions)))
        return -1;
    mf310p_v2_ib_probe_kernel<<<2, 0, stream>>>(
        reinterpret_cast<uint8_t*>(ibWorkspace),
        reinterpret_cast<uint8_t*>(result),
        repetitions, enabled);
    return 0;
}

/* G0 second stage: exactly the 8->1 / 1->7 pattern of the MM kernel. */
extern "C" __global__ __aicore__ void mf310p_v2_ib_fan_probe_kernel(
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* result,
    uint32_t repetitions, uint32_t enabled)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enabled) return;
    const uint32_t core = GetBlockIdx();
    if (core >= 8) return;
    TPipe pipe;
    TBuf<> syncBuf;
    pipe.InitBuffer(syncBuf, 32);
    GlobalTensor<int32_t> gm;
    gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
                       kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ub = syncBuf.Get<int32_t>();
    for (uint32_t i = 0; i < repetitions; ++i) {
        WaitReady(gm, ub, core);
        ReleaseAdd(gm, ub, core);
        WaitAddDone(gm, ub, core);
    }
    WriteResultSlot(result, core, repetitions);
}
using namespace AscendC;

extern "C" int mf310p_v2_ib_fan_probe_async(
    uint64_t ibWorkspace, uint64_t result, uint32_t repetitions,
    uint32_t enabled, aclrtStream stream)
{
    if (!stream || (enabled && (!ibWorkspace || !result || !repetitions)))
        return -1;
    mf310p_v2_ib_fan_probe_kernel<<<8, 0, stream>>>(
        reinterpret_cast<uint8_t*>(ibWorkspace),
        reinterpret_cast<uint8_t*>(result), repetitions, enabled);
    return 0;
}

#define V2_DIAG_CASE(K, ROWS)                                                   \
    case ROWS:                                                                  \
        K<tiling##ROWS, ROWS><<<kCores, 0, stream>>>(                           \
            reinterpret_cast<uint8_t*>(x),                                      \
            reinterpret_cast<uint8_t*>(w),                                      \
            reinterpret_cast<uint8_t*>(y), enable);                             \
        return 0;

/* 16-argument minimal kernel: reproduces the V2TrialKernel launch shape
 * to test the <<<>>> marshalling limit. */
__global__ __aicore__ void V2ArgCountProbeKernel(
    __gm__ uint8_t* a0, __gm__ uint8_t* a1, __gm__ uint8_t* a2,
    __gm__ uint8_t* a3, __gm__ uint8_t* a4, __gm__ uint8_t* a5,
    __gm__ uint8_t* a6, uint64_t a7, __gm__ uint8_t* a8, __gm__ uint8_t* a9,
    __gm__ uint8_t* a10, __gm__ uint8_t* a11, uint64_t a12,
    uint32_t a13, uint32_t a14, uint32_t a15)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (GetBlockIdx() != 0 || a15 == 0) return;
    /* Echo ALL received argument values into a9's 64B region so the host
     * can verify every slot of the 16-arg marshalling. */
    __gm__ volatile uint64_t* out =
        reinterpret_cast<__gm__ volatile uint64_t*>(a9);
    out[0] = reinterpret_cast<uint64_t>(a0);
    out[1] = reinterpret_cast<uint64_t>(a1);
    out[2] = reinterpret_cast<uint64_t>(a2);
    out[3] = reinterpret_cast<uint64_t>(a3);
    out[4] = reinterpret_cast<uint64_t>(a4);
    out[5] = reinterpret_cast<uint64_t>(a5);
    out[6] = reinterpret_cast<uint64_t>(a6);
    out[7] = a7;
    out[8] = reinterpret_cast<uint64_t>(a8);
    out[9] = 0xABCD000000000000ULL | (static_cast<uint64_t>(a13) << 32) |
        (static_cast<uint64_t>(a14) << 16) | a15;
    out[10] = reinterpret_cast<uint64_t>(a10);
    out[11] = reinterpret_cast<uint64_t>(a11);
    out[12] = a12;
    GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(a9), 8);
    DataCacheCleanAndInvalid<int32_t, CacheLine::SINGLE_CACHE_LINE>(g);
}

extern "C" int mf310p_v2_argcount_probe_async(
    uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t a4,
    uint64_t a5, uint64_t a6, uint64_t a7, uint64_t a8, uint64_t a9,
    uint64_t a10, uint64_t a11, uint64_t a12, uint32_t a13, uint32_t a14,
    uint32_t a15, aclrtStream stream)
{
    if (!stream || !a9) return -1;
    V2ArgCountProbeKernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(a0), reinterpret_cast<uint8_t*>(a1),
        reinterpret_cast<uint8_t*>(a2), reinterpret_cast<uint8_t*>(a3),
        reinterpret_cast<uint8_t*>(a4), reinterpret_cast<uint8_t*>(a5),
        reinterpret_cast<uint8_t*>(a6), a7, reinterpret_cast<uint8_t*>(a8),
        reinterpret_cast<uint8_t*>(a9), reinterpret_cast<uint8_t*>(a10),
        reinterpret_cast<uint8_t*>(a11), a12, a13, a14, a15);
    return 0;
}

extern "C" int mf310p_v2_diag_mm_async(
    uint64_t x, uint64_t w, uint64_t y, uint32_t chunkRows, uint32_t enable,
    aclrtStream stream)
{
    if (!stream || (enable && (!x || !w || !y))) return -1;
    switch (chunkRows) {
        V2_DIAG_CASE(V2DiagMmKernel, 256)
        V2_DIAG_CASE(V2DiagMmKernel, 512)
        V2_DIAG_CASE(V2DiagMmKernel, 1024)
        default: return -1;
    }
}

