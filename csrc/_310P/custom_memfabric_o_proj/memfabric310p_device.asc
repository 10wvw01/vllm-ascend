/*
 * vLLM-owned AscendC kernels for the wgm-dev-310p MemFabric public API.
 *
 * Producer path:
 *   - block 0: communication coordinator, the only public signal() caller;
 *   - blocks 1..7: FP16 o_proj MM workers;
 *   - per chunk: MM -> cache clean -> ready flag -> coordinator signal().
 *
 * MemFabric is treated as an opaque transport. This file does not inspect or
 * manipulate its mailbox/ring/orchestrator internals.
 *
 * The first launch of each kernel symbol from a freshly loaded .so is a
 * silent no-op on the target, so chunk-count-0 shapes are side-effect-free
 * warmups and the runtime launches every symbol twice before first use.
 */
#include <cstdint>

#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "lib/matmul/matmul_intf.h"
#include "smem_shm_aicore_base_sdma.h"

#define MF310P_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__

/*
 * Line-clean a region so peer-visible SDMA reads coherent bytes. Mirrors the
 * example-08 posture: iterate 64-byte cache lines with a per-line
 * clean+invalidate instead of flushing the entire data cache, so the matmul's
 * own cached lines survive between chunks.
 */
MF310P_AICORE_INLINE void Mf310pCleanRegion(__gm__ uint8_t* base, uint64_t bytes)
{
    AscendC::GlobalTensor<int32_t> gm;
    for (uint64_t off = 0; off < bytes; off += 64) {
        gm.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(
                reinterpret_cast<uintptr_t>(base) + off),
            16);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(gm);
    }
}

/* ======================================================================
 * Direct producer: coordinator-pipelined FP16 matmul -> signal.
 *
 * One kernel performs every chunk of a wave for its M-bucket. Per chunk it
 * runs the AscendC cube matmul A(ND [m_bucket, 2048]) x B(NZ [2048, 2048],
 * transposed) writing C directly into the immutable send-arena slot, cleans
 * the slot on this core, then calls the public signal() transport primitive;
 * transfer may proceed while other workers continue later chunks.
 *
 * The matmul recipe below is the bit-exact-validated dav-2002 configuration
 * (verified against F.linear over m = 1..4096):
 *   - static tiling from GetMatmulApiTiling with CONFIG_MDL, base tile
 *     128^3, M specialized per power-of-two bucket;
 *   - buckets < 256 generate with l1Size = 128 KiB: the default generator
 *     produces an A-full-load schedule whose UB staging requirement
 *     overflows the 256 KiB dav-2002 UB and faults (MTE out of bounds);
 *   - enVecND2NZ = true: the OnTheFly ND2NZ A path is broken on dav-2002
 *     (rows within each baseM tile broadcast row 0); the vector path
 *     staging through the mandatory SetLocalWorkspace buffer is exact;
 *   - explicit runtime transpose flag on SetTensorB (the MatmulType
 *     isTrans does not reach SetTensorB's defaulted argument);
 *   - REGIST_MATMUL_OBJ + zero-initialized TCubeTiling (garbage stack
 *     tiling fields otherwise leak into the runtime fallback path).
 * ====================================================================== */
namespace {

using namespace AscendC;

using Mf310pANd = MatmulType<TPosition::GM, CubeFormat::ND, float16_t, false>;
using Mf310pBNzT = MatmulType<TPosition::GM, CubeFormat::NZ, float16_t, true>;
using Mf310pCNd = MatmulType<TPosition::GM, CubeFormat::ND, float16_t, false>;
using Mf310pBiasF = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;

constexpr uint32_t MF310P_O_PROJ_N = 2048;
constexpr uint32_t MF310P_O_PROJ_K = 2048;
constexpr uint32_t MF310P_MATMUL_BASE_M = 128;
constexpr uint32_t MF310P_MATMUL_BASE_N = 128;
constexpr uint32_t MF310P_MATMUL_BASE_K = 128;

constexpr MatmulQuantParams kMf310pQuant = {false, false};
constexpr MatmulBatchParams kMf310pBatch = {false, BatchMode::NONE};
constexpr MatmulFuncParams kMf310pFunc = {false, true, false, false, 0,
    IterateOrder::UNDEF, ScheduleType::INNER_PRODUCT, true, true};

#define MF310P_PRODUCER_TILING(TAG, MB, L1)                                          \
    constexpr MatmulShapeParams mf310pSp##TAG = {                           \
        MB, MF310P_O_PROJ_N, MF310P_O_PROJ_K,                                        \
        MF310P_MATMUL_BASE_M, MF310P_MATMUL_BASE_N, MF310P_MATMUL_BASE_K};           \
    constexpr MatmulConfig mf310pCfg##TAG =                                 \
        GetMMConfig<MatmulConfigMode::CONFIG_MDL>(                 \
            mf310pSp##TAG, kMf310pQuant, kMf310pBatch, kMf310pFunc);                 \
    constexpr static MatmulApiStaticTiling mf310pSt##TAG =                  \
        GetMatmulApiTiling<Mf310pANd, Mf310pBNzT, Mf310pCNd, Mf310pBiasF>(  \
            mf310pCfg##TAG, L1);

MF310P_PRODUCER_TILING(16, 16, 128 * 1024)
MF310P_PRODUCER_TILING(32, 32, 128 * 1024)
MF310P_PRODUCER_TILING(64, 64, 128 * 1024)
MF310P_PRODUCER_TILING(128, 128, 128 * 1024)
MF310P_PRODUCER_TILING(256, 256, Impl::L1_SIZE)
MF310P_PRODUCER_TILING(512, 512, Impl::L1_SIZE)
MF310P_PRODUCER_TILING(1024, 1024, Impl::L1_SIZE)
MF310P_PRODUCER_TILING(2048, 2048, Impl::L1_SIZE)
MF310P_PRODUCER_TILING(4096, 4096, Impl::L1_SIZE)

/* Coordinator pipeline and vLLM-owned protocol diagnostics.
 *
 * Block 0 is the only MemFabric producer. Blocks 1..7 are MM workers.
 * A device failure records a stable vLLM status code and traps the kernel,
 * preventing add/ack from silently advancing a corrupted wave.
 */
constexpr uint64_t MF310P_READY_STRIDE_BYTES = 64;
constexpr uint64_t MF310P_READY_VALUE = 1;
constexpr uint64_t MF310P_READY_POLL_MAX_ITER = 100000000ULL;
constexpr uint64_t MF310P_CREDIT_TAG = 0x4D46435245444954ULL; /* MFCREDIT */

enum Mf310pProtocolStatus : uint64_t {
    MF310P_STATUS_OK = 0,
    MF310P_STATUS_READY_TIMEOUT = 1,
    MF310P_STATUS_SIGNAL_FAILED = 2,
    MF310P_STATUS_QUIET_FAILED = 3,
    MF310P_STATUS_WAIT_FAILED = 4,
    MF310P_STATUS_MAIL_MISMATCH = 5,
    MF310P_STATUS_CREDIT_MISMATCH = 6,
    MF310P_STATUS_ACK_FAILED = 7,
};

MF310P_AICORE_INLINE void Mf310pFlushLine(__gm__ uint8_t* cell)
{
    AscendC::GlobalTensor<int32_t> t;
    t.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cell), 16);
    AscendC::DataCacheCleanAndInvalid<
        int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(t);
}

MF310P_AICORE_INLINE void Mf310pFail(__gm__ uint8_t* protocolStatus, uint64_t code)
{
    *reinterpret_cast<__gm__ volatile uint64_t*>(protocolStatus) = code;
    Mf310pFlushLine(protocolStatus);
    AscendC::Trap();
}

MF310P_AICORE_INLINE void Mf310pWriteReady(__gm__ uint8_t* control, uint32_t index)
{
    __gm__ uint8_t* cell =
        control + static_cast<uint64_t>(index) * MF310P_READY_STRIDE_BYTES;
    *reinterpret_cast<__gm__ volatile uint64_t*>(cell) = MF310P_READY_VALUE;
    Mf310pFlushLine(cell);
}

MF310P_AICORE_INLINE bool Mf310pWaitReady(__gm__ uint8_t* control, uint32_t index)
{
    __gm__ uint8_t* cell =
        control + static_cast<uint64_t>(index) * MF310P_READY_STRIDE_BYTES;
    AscendC::GlobalTensor<int32_t> t;
    t.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cell), 16);
    for (uint64_t iter = 0; iter < MF310P_READY_POLL_MAX_ITER; ++iter) {
        /* Reader never writes this cache line; every worker owns another
         * 64B line, so cache refresh cannot collide with worker writeback. */
        AscendC::DataCacheCleanAndInvalid<
            int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(t);
        if (*reinterpret_cast<__gm__ volatile uint64_t*>(cell) == MF310P_READY_VALUE) {
            return true;
        }
        if (iter >= 4096) __asm__ __volatile__("" ::: "memory");
    }
    return false;
}

template <const MatmulApiStaticTiling& ST, uint32_t M_BUCKET>
__global__ __aicore__ void Mf310pDirectProducerKernel(
    __gm__ uint8_t* gva, __gm__ uint8_t* xGm, __gm__ uint8_t* wGm,
    __gm__ uint8_t* sendArena, __gm__ uint8_t* peerRecvArena,
    __gm__ uint8_t* producerControl, __gm__ uint8_t* protocolStatus,
    uint32_t firstChunk, uint32_t chunkCount, uint32_t aAdvanceRows,
    uint64_t chunkBytes, uint32_t workerCount)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (chunkCount == 0) return;
    const uint32_t block = GetBlockIdx();

    if (block == 0) {
        for (uint32_t i = 0; i < chunkCount; ++i) {
            if (!Mf310pWaitReady(producerControl, i)) {
                Mf310pFail(protocolStatus, MF310P_STATUS_READY_TIMEOUT);
                return;
            }
            const uint32_t chunk = firstChunk + i;
            __gm__ uint8_t* src = sendArena + static_cast<uint64_t>(chunk) * chunkBytes;
            __gm__ uint8_t* dst = peerRecvArena + static_cast<uint64_t>(chunk) * chunkBytes;
            if (!smem_shm_sdma_signal(gva, src, dst, chunkBytes, chunk)) {
                Mf310pFail(protocolStatus, MF310P_STATUS_SIGNAL_FAILED);
                return;
            }
        }
        return;
    }

    const uint32_t worker = block - 1;
    if (worker >= workerCount) return;

    TPipe pipe;
    TCubeTiling rt{};
    rt.usedCoreNum = 1;
    Matmul<Mf310pANd, Mf310pBNzT, Mf310pCNd, Mf310pBiasF, ST> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &rt);
    TBuf<> ubBuf;
    pipe.InitBuffer(ubBuf, TOTAL_UB_SIZE);
    mm.SetLocalWorkspace(ubBuf.Get<uint8_t>());

    GlobalTensor<float16_t> aGm;
    GlobalTensor<float16_t> bGm;
    bGm.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(wGm),
                        MF310P_O_PROJ_N * MF310P_O_PROJ_K);
    GlobalTensor<float16_t> cGm;

    for (uint32_t i = worker; i < chunkCount; i += workerCount) {
        const uint32_t chunk = firstChunk + i;
        __gm__ uint8_t* slot = sendArena + static_cast<uint64_t>(chunk) * chunkBytes;
        aGm.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(
            xGm + static_cast<uint64_t>(i) * aAdvanceRows *
                      MF310P_O_PROJ_K * sizeof(float16_t)),
            M_BUCKET * MF310P_O_PROJ_K);
        cGm.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(slot),
                            M_BUCKET * MF310P_O_PROJ_N);
        mm.SetTensorA(aGm, false);
        mm.SetTensorB(bGm, true);
        mm.SetOrgShape(M_BUCKET, MF310P_O_PROJ_N, MF310P_O_PROJ_K,
                       MF310P_O_PROJ_K, MF310P_O_PROJ_N);
        mm.IterateAll(cGm);
        Mf310pCleanRegion(slot, chunkBytes);
        Mf310pWriteReady(producerControl, i);
    }
}

} // namespace

/* ======================================================================
 * Waiter: quiet -> wait x chunks. Enqueued on the same stream after this
 * rank's producers; everything after it may read both arenas:
 *   - public quiet proves all of this rank's signals landed at the peer;
 *   - public wait consumes this rank's own mails in signal order, so recv
 *     arena holds every peer chunk.
 * Any transport or mail-contract violation records a vLLM status and traps.
 * ====================================================================== */
extern "C" __global__ __aicore__ void mf310pWaitKernel(
    __gm__ uint8_t* gva, __gm__ uint8_t* recvArena,
    __gm__ uint8_t* protocolStatus, uint32_t chunks, uint64_t chunkBytes)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (GetBlockIdx() != 0 || chunks == 0) return;
    if (!smem_shm_sdma_quiet(gva)) {
        Mf310pFail(protocolStatus, MF310P_STATUS_QUIET_FAILED);
        return;
    }
    for (uint32_t c = 0; c < chunks; ++c) {
        smem_shm_sdma_mail_t m = smem_shm_sdma_wait(gva);
        if (m.status != SMEM_SHM_SDMA_MAIL_OK) {
            Mf310pFail(protocolStatus, MF310P_STATUS_WAIT_FAILED);
            return;
        }
        const uint64_t expectedDst =
            reinterpret_cast<uint64_t>(recvArena) + static_cast<uint64_t>(c) * chunkBytes;
        if (m.dst != expectedDst || m.len != chunkBytes || m.imm != c) {
            Mf310pFail(protocolStatus, MF310P_STATUS_MAIL_MISMATCH);
            return;
        }
    }
}

/* ======================================================================
 * Multi-block vector reduce: out[wave] = send[wave] + recv[wave].
 *
 * Replaces at::add_out on the hot path: torch_npu's elementwise add pays a
 * per-output-shape GE compile (~90 ms measured) on first use, which is
 * unacceptable for production where M varies per request. This kernel is
 * shape-agnostic (element count parameter) and correctly-rounded, so it is
 * bit-exact with the FP32-math reference (two FP16 inputs sum exactly in
 * FP32; any correctly-rounded FP16 add equals that single rounding).
 *
 * Each block owns one 128-element-aligned contiguous slice; tiles move
 * through double-buffered TQue pairs so MTE2/V/MTE3 overlap. wave element
 * counts are always multiples of 2048 (rows * o_proj width), and slices are
 * 128-aligned, so every tile count is a multiple of 128 - no tail handling.
 * ====================================================================== */
constexpr uint32_t MF310P_ADD_MAX_BLOCKS = 8;
constexpr uint32_t MF310P_ADD_TILE_ELEMS = 16384; /* FP16 elems; 32 KiB */
constexpr uint64_t MF310P_ADD_SLICE_ALIGN = 128;  /* FP16 elems */

extern "C" __global__ __aicore__ void mf310pAddKernel(
    __gm__ uint8_t* outGm,
    __gm__ uint8_t* sendGm,
    __gm__ uint8_t* recvGm,
    uint64_t elems,
    uint32_t blockCount)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (GetBlockIdx() >= blockCount || elems == 0) {
        return;
    }
    const uint64_t slice =
        ((elems + blockCount - 1) / blockCount + MF310P_ADD_SLICE_ALIGN - 1) &
        ~(MF310P_ADD_SLICE_ALIGN - 1);
    const uint64_t begin = static_cast<uint64_t>(GetBlockIdx()) * slice;
    if (begin >= elems) {
        return;
    }
    const uint64_t end = begin + slice < elems ? begin + slice : elems;

    TPipe pipe;
    TQue<TPosition::VECIN, 2> inQueA;
    TQue<TPosition::VECIN, 2> inQueB;
    TQue<TPosition::VECOUT, 2> outQue;
    pipe.InitBuffer(inQueA, 2, MF310P_ADD_TILE_ELEMS * sizeof(float16_t));
    pipe.InitBuffer(inQueB, 2, MF310P_ADD_TILE_ELEMS * sizeof(float16_t));
    pipe.InitBuffer(outQue, 2, MF310P_ADD_TILE_ELEMS * sizeof(float16_t));

    __gm__ float16_t* outH = reinterpret_cast<__gm__ float16_t*>(outGm);
    __gm__ float16_t* sendH = reinterpret_cast<__gm__ float16_t*>(sendGm);
    __gm__ float16_t* recvH = reinterpret_cast<__gm__ float16_t*>(recvGm);

    for (uint64_t off = begin; off < end; off += MF310P_ADD_TILE_ELEMS) {
        const uint32_t n = static_cast<uint32_t>(
            end - off < MF310P_ADD_TILE_ELEMS ? end - off
                                              : MF310P_ADD_TILE_ELEMS);

        GlobalTensor<float16_t> sendView;
        sendView.SetGlobalBuffer(sendH + off, n);
        GlobalTensor<float16_t> recvView;
        recvView.SetGlobalBuffer(recvH + off, n);
        GlobalTensor<float16_t> outView;
        outView.SetGlobalBuffer(outH + off, n);

        LocalTensor<float16_t> a = inQueA.AllocTensor<float16_t>();
        DataCopy(a, sendView, n);
        inQueA.EnQue(a);
        LocalTensor<float16_t> b = inQueB.AllocTensor<float16_t>();
        DataCopy(b, recvView, n);
        inQueB.EnQue(b);

        LocalTensor<float16_t> va = inQueA.DeQue<float16_t>();
        LocalTensor<float16_t> vb = inQueB.DeQue<float16_t>();
        LocalTensor<float16_t> o = outQue.AllocTensor<float16_t>();
        Add(o, va, vb, n);
        outQue.EnQue(o);

        LocalTensor<float16_t> vo = outQue.DeQue<float16_t>();
        DataCopy(outView, vo, n);
        outQue.FreeTensor(vo);
        inQueA.FreeTensor(va);
        inQueB.FreeTensor(vb);
    }
}

/* ======================================================================
 * Graph-safe fixed-credit rendezvous. FIFO ordering makes wave ids unnecessary.
 * ====================================================================== */
extern "C" __global__ __aicore__ void mf310pAckKernel(
    __gm__ uint8_t* gva, __gm__ uint8_t* ackSlot,
    __gm__ uint8_t* peerAckSlot, __gm__ uint8_t* protocolStatus, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (GetBlockIdx() != 0 || enable == 0) return;
    Mf310pCleanRegion(ackSlot, 8);
    if (!smem_shm_sdma_signal(gva, ackSlot, peerAckSlot, 8, MF310P_CREDIT_TAG)) {
        Mf310pFail(protocolStatus, MF310P_STATUS_ACK_FAILED);
    }
}

extern "C" __global__ __aicore__ void mf310pGateKernel(
    __gm__ uint8_t* gva, __gm__ uint8_t* ackSlot,
    __gm__ uint8_t* protocolStatus, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (GetBlockIdx() != 0 || enable == 0) return;
    smem_shm_sdma_mail_t m = smem_shm_sdma_wait(gva);
    if (m.status != SMEM_SHM_SDMA_MAIL_OK ||
        m.dst != reinterpret_cast<uint64_t>(ackSlot) ||
        m.len != 8 || m.imm != MF310P_CREDIT_TAG) {
        Mf310pFail(protocolStatus, MF310P_STATUS_CREDIT_MISMATCH);
    }
}

extern "C" __global__ __aicore__ void mf310pQuietKernel(
    __gm__ uint8_t* gva, __gm__ uint8_t* protocolStatus, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (GetBlockIdx() != 0 || enable == 0) return;
    if (!smem_shm_sdma_quiet(gva)) {
        Mf310pFail(protocolStatus, MF310P_STATUS_QUIET_FAILED);
    }
}

#define MF310P_PRODUCER_LAUNCH_CASE(mbucket)                                         \
    case mbucket: {                                                                  \
        Mf310pDirectProducerKernel<mf310pSt##mbucket, mbucket>                       \
            <<<launch_blocks, 0, stream>>>(                                          \
                reinterpret_cast<uint8_t*>(pool_base),                               \
                reinterpret_cast<uint8_t*>(x), reinterpret_cast<uint8_t*>(w),        \
                reinterpret_cast<uint8_t*>(send_arena),                              \
                reinterpret_cast<uint8_t*>(peer_recv_arena),                         \
                reinterpret_cast<uint8_t*>(producer_control),                        \
                reinterpret_cast<uint8_t*>(protocol_status),                         \
                first_chunk, chunk_count, a_advance_rows, chunk_bytes, worker_count);\
        return 0;                                                                    \
    }

constexpr uint32_t MF310P_PRODUCER_BLOCKS = 8;
constexpr uint32_t MF310P_PRODUCER_WORKERS = MF310P_PRODUCER_BLOCKS - 1;

extern "C" int mf310p_device_launch_direct_producer_async(
    uint64_t pool_base, uint64_t x, uint64_t w, uint64_t send_arena,
    uint64_t peer_recv_arena, uint32_t m_bucket, uint32_t first_chunk,
    uint32_t chunk_count, uint32_t a_advance_rows, uint64_t chunk_bytes,
    uint64_t producer_control, uint64_t protocol_status, aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0 || x == 0 || w == 0 ||
        send_arena == 0 || peer_recv_arena == 0 || producer_control == 0 ||
        protocol_status == 0 || chunk_count == 0 ||
        chunk_bytes == 0 || (chunk_bytes % 4) != 0 ||
        (chunk_count > 1 && a_advance_rows < m_bucket) ||
        static_cast<uint64_t>(m_bucket) * MF310P_O_PROJ_N * sizeof(float16_t) > chunk_bytes) return -1;
    const uint32_t worker_count =
        chunk_count < MF310P_PRODUCER_WORKERS ? chunk_count
                                             : MF310P_PRODUCER_WORKERS;
    const uint32_t launch_blocks = worker_count + 1;
    switch (m_bucket) {
        MF310P_PRODUCER_LAUNCH_CASE(16)
        MF310P_PRODUCER_LAUNCH_CASE(32)
        MF310P_PRODUCER_LAUNCH_CASE(64)
        MF310P_PRODUCER_LAUNCH_CASE(128)
        MF310P_PRODUCER_LAUNCH_CASE(256)
        MF310P_PRODUCER_LAUNCH_CASE(512)
        MF310P_PRODUCER_LAUNCH_CASE(1024)
        MF310P_PRODUCER_LAUNCH_CASE(2048)
        MF310P_PRODUCER_LAUNCH_CASE(4096)
    default: return -1;
    }
}
#undef MF310P_PRODUCER_LAUNCH_CASE

extern "C" int mf310p_device_wait_mails_async(
    uint64_t pool_base, uint64_t recv_arena, uint64_t chunk_bytes,
    uint64_t protocol_status, uint32_t chunks, aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0 || recv_arena == 0 ||
        chunk_bytes == 0 || protocol_status == 0 || chunks == 0) return -1;
    mf310pWaitKernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(pool_base),
        reinterpret_cast<uint8_t*>(recv_arena),
        reinterpret_cast<uint8_t*>(protocol_status),
        chunks, chunk_bytes);
    return 0;
}

/* chunk_count == 0: the producer kernel returns before touching any memory,
 * so x/w/arenas are never dereferenced; only the kernel symbol needs to be
 * warmed. Same for the waiter's chunks == 0 shape. */
#define MF310P_PRODUCER_WARMUP_CASE(mbucket)                                         \
    case mbucket:                                                                    \
        Mf310pDirectProducerKernel<mf310pSt##mbucket, mbucket>                       \
            <<<2, 0, stream>>>(                                                      \
                reinterpret_cast<uint8_t*>(pool_base),                               \
                reinterpret_cast<uint8_t*>(pool_base),                               \
                reinterpret_cast<uint8_t*>(pool_base),                               \
                reinterpret_cast<uint8_t*>(pool_base),                               \
                reinterpret_cast<uint8_t*>(pool_base),                               \
                reinterpret_cast<uint8_t*>(pool_base),                               \
                reinterpret_cast<uint8_t*>(pool_base),                               \
                0, 0, m_bucket, chunk_bytes, 1);                                     \
        return 0;

extern "C" int mf310p_device_warmup_producer_async(
    uint64_t pool_base, uint32_t m_bucket, uint64_t chunk_bytes, aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0 || chunk_bytes == 0 ||
        (chunk_bytes % 4) != 0 ||
        static_cast<uint64_t>(m_bucket) * MF310P_O_PROJ_N * sizeof(float16_t) > chunk_bytes) return -1;
    switch (m_bucket) {
        MF310P_PRODUCER_WARMUP_CASE(16)
        MF310P_PRODUCER_WARMUP_CASE(32)
        MF310P_PRODUCER_WARMUP_CASE(64)
        MF310P_PRODUCER_WARMUP_CASE(128)
        MF310P_PRODUCER_WARMUP_CASE(256)
        MF310P_PRODUCER_WARMUP_CASE(512)
        MF310P_PRODUCER_WARMUP_CASE(1024)
        MF310P_PRODUCER_WARMUP_CASE(2048)
        MF310P_PRODUCER_WARMUP_CASE(4096)
    default: return -1;
    }
}
#undef MF310P_PRODUCER_WARMUP_CASE

extern "C" int mf310p_device_warmup_waiter_async(
    uint64_t pool_base,
    aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0) {
        return -1;
    }
    mf310pWaitKernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(pool_base),
        reinterpret_cast<uint8_t*>(pool_base),
        reinterpret_cast<uint8_t*>(pool_base),
        0, 0);
    return 0;
}

extern "C" int mf310p_device_add_async(
    uint64_t out,
    uint64_t send_arena,
    uint64_t recv_arena,
    uint64_t elems,
    uint32_t block_count,
    aclrtStream stream)
{
    if (stream == nullptr || out == 0 || send_arena == 0 || recv_arena == 0 ||
        elems == 0 || (elems % MF310P_ADD_SLICE_ALIGN) != 0 ||
        block_count == 0 || block_count > MF310P_ADD_MAX_BLOCKS) {
        return -1;
    }
    mf310pAddKernel<<<MF310P_ADD_MAX_BLOCKS, 0, stream>>>(
        reinterpret_cast<uint8_t*>(out),
        reinterpret_cast<uint8_t*>(send_arena),
        reinterpret_cast<uint8_t*>(recv_arena),
        elems,
        block_count);
    return 0;
}

extern "C" int mf310p_device_ack_async(
    uint64_t pool_base, uint64_t ack_slot, uint64_t peer_ack_slot,
    uint64_t protocol_status, uint32_t enable, aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0 || ack_slot == 0 ||
        peer_ack_slot == 0 || protocol_status == 0 || enable > 1) return -1;
    mf310pAckKernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(pool_base),
        reinterpret_cast<uint8_t*>(ack_slot),
        reinterpret_cast<uint8_t*>(peer_ack_slot),
        reinterpret_cast<uint8_t*>(protocol_status), enable);
    return 0;
}

extern "C" int mf310p_device_gate_async(
    uint64_t pool_base, uint64_t ack_slot, uint64_t protocol_status,
    uint32_t enable, aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0 || ack_slot == 0 ||
        protocol_status == 0 || enable > 1) return -1;
    mf310pGateKernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(pool_base),
        reinterpret_cast<uint8_t*>(ack_slot),
        reinterpret_cast<uint8_t*>(protocol_status), enable);
    return 0;
}

extern "C" int mf310p_device_quiet_async(
    uint64_t pool_base, uint64_t protocol_status,
    uint32_t enable, aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0 || protocol_status == 0 || enable > 1) return -1;
    mf310pQuietKernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(pool_base),
        reinterpret_cast<uint8_t*>(protocol_status), enable);
    return 0;
}

/* elems == 0 is the side-effect-free warmup shape (every block returns
 * before touching memory). */
extern "C" int mf310p_device_warmup_add_async(
    uint64_t arena,
    aclrtStream stream)
{
    if (stream == nullptr || arena == 0) {
        return -1;
    }
    mf310pAddKernel<<<MF310P_ADD_MAX_BLOCKS, 0, stream>>>(
        reinterpret_cast<uint8_t*>(arena),
        reinterpret_cast<uint8_t*>(arena),
        reinterpret_cast<uint8_t*>(arena),
        0,
        1);
    return 0;
}
