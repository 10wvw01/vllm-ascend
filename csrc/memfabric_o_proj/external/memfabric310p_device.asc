/*
 * Device-side cooperation kernels for the customized wgm-dev-310p MemFabric.
 *
 * This intentionally mirrors examples/memory_pool/01_basic/
 * 08_310p_aicore_aicpu_sdma: AICore publishes a GM mailbox after cleaning the
 * produced chunk, AICPU/SDMA transfers it, and a peer AICore polls the arrival
 * flag before consuming the data.
 *
 * The first implementation is deliberately scalar/single-block.  It is the
 * correctness baseline; once validated on 310P3, the reduce loop will be
 * replaced with a vectorized/multi-core implementation without changing the
 * adapter ABI or vLLM integration.
 */
#include <cstdint>

#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem_shm_aicore_sdma.h"

#define MF310P_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__

/*
 * FP16 payload conversions. The model runs with FP16 activations/weights on
 * 310P (owner decision A: the target o_proj is unquantized; the checkpoint
 * carries no torch_dtype so vLLM runs it as FP16, and BF16 NZ linear is not
 * supported by this CANN anyway). float16_t is native on dav-2002, so the
 * correctness baseline reduces FP16 through float32, matching torch FP16 add
 * semantics.
 */
MF310P_AICORE_INLINE float Mf310pFp16ToFloat(float16_t v)
{
    return static_cast<float>(v);
}

MF310P_AICORE_INLINE float16_t Mf310pFloatToFp16(float f)
{
    return static_cast<float16_t>(f);
}

MF310P_AICORE_INLINE void Mf310pCleanWords(__gm__ uint32_t* base, uint64_t words)
{
    AscendC::GlobalTensor<int32_t> gm;
    gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(base), words);
    AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::ENTIRE_DATA_CACHE>(gm);
}

/*
 * Producer notification. The actual W8A8 matmul/copy that fills send_arena is
 * ordered before this kernel on the same compute stream. Therefore publication
 * is one-way ordered:
 *
 *     MM/copy[t] -> clean[t] -> notify[t]
 *
 * and there is no dependency from SDMA[t] back to MM[t+1].
 */
extern "C" __global__ __aicore__ void mf310pPublishKernel(
    __gm__ uint8_t* workspace,
    __gm__ uint8_t* sendArena,
    uint32_t chunkIdx,
    uint64_t chunkBytes,
    uint64_t validBytes)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }

    __gm__ uint8_t* chunk = sendArena + static_cast<uint64_t>(chunkIdx) * chunkBytes;
    const uint64_t words = validBytes / sizeof(uint32_t);
    Mf310pCleanWords(reinterpret_cast<__gm__ uint32_t*>(chunk), words);

    __gm__ uint8_t* mailbox = workspace + SMEM_SHM_SDMA_WS_MAILBOX_OFF;
    smem_shm_sdma_notify(
        mailbox + static_cast<uint64_t>(chunkIdx) * SMEM_SHM_SDMA_WS_MAILBOX_SLOT_SIZE,
        reinterpret_cast<uint64_t>(chunk),
        words);
}

/*
 * Peer reduction consumer. recvArena is both receive buffer and final output;
 * sendArena remains immutable until the wave joins, so this kernel cannot race
 * the peer SDMA source.
 *
 * Two independent gates per chunk (both device-side spin polls, so the reduce
 * stream never couples to the compute stream and MM[t+1] stays independent):
 *   - produced gate: mailbox slot c's words field is written by the local
 *     publish kernel only after the chunk was cleaned; polling it orders the
 *     reduce's send read after the local producer (real-machine race fix:
 *     without it the reduce could read send before MM/copy ever wrote it).
 *   - arrival gate: flag c is written by the peer SDMA pair only after the
 *     peer's chunk data landed ("flag arrives => data arrives" FIFO contract).
 *
 * Before reading send[c] the chunk is invalidated on this core: a previous
 * wave's reduce may still hold cached lines for the same addresses (the arenas
 * are reused every wave), and the publish-side clean only flushes the
 * publishing core.
 *
 * Target contract is the unquantized Qwen3.6 o_proj with FP16 output.  A later
 * optimized kernel will vectorize this loop, but preserving this memory
 * ownership is more important than premature micro-optimization.
 */
extern "C" __global__ __aicore__ void mf310pReduceConsumerKernel(
    __gm__ uint8_t* workspace,
    __gm__ uint8_t* sendArena,
    __gm__ uint8_t* recvArena,
    __gm__ uint64_t* arrivalFlags,
    uint32_t chunks,
    uint64_t chunkBytes)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }

    __gm__ uint8_t* mailbox = workspace + SMEM_SHM_SDMA_WS_MAILBOX_OFF;
    const uint64_t elemsPerChunk = chunkBytes / sizeof(float16_t); /* FP16 = 2B */
    for (uint32_t c = 0; c < chunks; ++c) {
        uint64_t pollIters = 0;

        /* Produced gate: local publish kernel wrote this chunk's mailbox slot
         * (words != 0) after producing and cleaning the send data. */
        const uint64_t produced = smem_shm_sdma_poll_flag(
            reinterpret_cast<__gm__ void*>(
                mailbox + static_cast<uint64_t>(c) * SMEM_SHM_SDMA_WS_MAILBOX_SLOT_SIZE +
                sizeof(uint64_t)),
            &pollIters);
        if (produced == 0) {
            return;
        }

        const uint64_t flag = smem_shm_sdma_poll_flag(
            reinterpret_cast<__gm__ void*>(arrivalFlags + c), &pollIters);
        if (flag == 0) {
            return;
        }

        __gm__ float16_t* send = reinterpret_cast<__gm__ float16_t*>(
            sendArena + static_cast<uint64_t>(c) * chunkBytes);
        __gm__ float16_t* recv = reinterpret_cast<__gm__ float16_t*>(
            recvArena + static_cast<uint64_t>(c) * chunkBytes);

        /* Invalidate send on this core before reading: previous waves' reduces
         * may have cached these addresses, and the arenas are reused. */
        Mf310pCleanWords(
            reinterpret_cast<__gm__ uint32_t*>(send),
            chunkBytes / sizeof(uint32_t));

        for (uint64_t i = 0; i < elemsPerChunk; ++i) {
            const float lhs = Mf310pFp16ToFloat(recv[i]);
            const float rhs = Mf310pFp16ToFloat(send[i]);
            recv[i] = Mf310pFloatToFp16(lhs + rhs);
        }

        Mf310pCleanWords(
            reinterpret_cast<__gm__ uint32_t*>(recv),
            chunkBytes / sizeof(uint32_t));
    }
}

extern "C" int mf310p_device_publish_chunk_async(
    void* workspace,
    uint64_t send_arena,
    uint32_t chunk_idx,
    uint64_t chunk_bytes,
    uint64_t valid_bytes,
    aclrtStream stream)
{
    if (workspace == nullptr || stream == nullptr || valid_bytes == 0 ||
        valid_bytes > chunk_bytes || (valid_bytes % sizeof(uint32_t)) != 0) {
        return -1;
    }
    mf310pPublishKernel<<<1, 0, stream>>>(
        static_cast<uint8_t*>(workspace),
        reinterpret_cast<uint8_t*>(send_arena),
        chunk_idx,
        chunk_bytes,
        valid_bytes);
    return 0;
}

extern "C" int mf310p_device_launch_reduce_consumer_async(
    uint64_t workspace,
    uint64_t send_arena,
    uint64_t recv_arena,
    uint64_t arrival_flags,
    uint32_t chunks,
    uint64_t chunk_bytes,
    aclrtStream stream)
{
    if (stream == nullptr || chunks == 0 || chunk_bytes == 0 ||
        (chunk_bytes % sizeof(uint32_t)) != 0) {
        return -1;
    }
    mf310pReduceConsumerKernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(workspace),
        reinterpret_cast<uint8_t*>(send_arena),
        reinterpret_cast<uint8_t*>(recv_arena),
        reinterpret_cast<uint64_t*>(arrival_flags),
        chunks,
        chunk_bytes);
    return 0;
}
